diff --git a/frontend/src/Utilities/ssoReauthentication.mjs b/frontend/src/Utilities/ssoReauthentication.mjs
new file mode 100644
--- /dev/null
+++ b/frontend/src/Utilities/ssoReauthentication.mjs
@@ -0,0 +1,180 @@
+const ATTEMPT_KEY = 'servarr.sso.reauth-attempt.v1';
+const REAUTH_HEADER = 'x-sso-reauth';
+const REAUTH_RETRY_DELAY_MS = 60 * 1000;
+const SESSION_PATH = '/oauth2/session';
+const XHR_PATCHED = Symbol('servarr.sso.xhr-patched');
+
+const responseUrl = (response) => response?.url || response?.responseURL || '';
+
+const responseHeader = (response, name) => {
+  if (typeof response?.headers?.get === 'function') {
+    return response.headers.get(name);
+  }
+  if (typeof response?.getResponseHeader === 'function') {
+    return response.getResponseHeader(name);
+  }
+  return null;
+};
+
+export const sameOriginResponse = (response, origin) => {
+  const url = responseUrl(response);
+  if (!url) {
+    return false;
+  }
+  try {
+    return new URL(url, origin).origin === origin;
+  } catch {
+    return false;
+  }
+};
+
+export const isSsoReauthResponse = (response, origin) =>
+  response?.status === 401 &&
+  responseHeader(response, REAUTH_HEADER) === '1' &&
+  sameOriginResponse(response, origin);
+
+export const reauthUrl = (origin) => {
+  const returnUrl = new URL('/', origin).href;
+  return `/oauth2/start?rd=${encodeURIComponent(returnUrl)}`;
+};
+
+export const createSsoReauthController = ({
+  fetchImpl,
+  location,
+  storage,
+  now = () => Date.now()
+}) => {
+  let navigating = false;
+
+  const getStored = (key) => {
+    try {
+      return storage.getItem(key);
+    } catch {
+      return null;
+    }
+  };
+
+  const removeStored = (key) => {
+    try {
+      storage.removeItem(key);
+    } catch {
+      // Reauthentication remains safe if storage is unavailable.
+    }
+  };
+
+  const beginReauthentication = () => {
+    if (navigating) {
+      return true;
+    }
+
+    const attemptedAt = Number(getStored(ATTEMPT_KEY));
+    const age = now() - attemptedAt;
+    if (
+      Number.isFinite(attemptedAt) &&
+      attemptedAt > 0 &&
+      age >= 0 &&
+      age < REAUTH_RETRY_DELAY_MS
+    ) {
+      return true;
+    }
+
+    try {
+      storage.setItem(ATTEMPT_KEY, String(now()));
+    } catch {
+      // Only the persisted loop guard is lost.
+    }
+
+    navigating = true;
+    location.assign(reauthUrl(location.origin));
+    return true;
+  };
+
+  const inspectResponse = (response) => {
+    if (isSsoReauthResponse(response, location.origin)) {
+      return beginReauthentication();
+    }
+    if (
+      !navigating &&
+      response?.status >= 200 &&
+      response.status < 400 &&
+      sameOriginResponse(response, location.origin)
+    ) {
+      removeStored(ATTEMPT_KEY);
+    }
+    return false;
+  };
+
+  const wrappedFetch = async (input, init) => {
+    const response = await fetchImpl(input, init);
+    inspectResponse(response);
+    return response;
+  };
+
+  const checkSession = async () => {
+    try {
+      const response = await fetchImpl(SESSION_PATH, {
+        cache: 'no-store',
+        credentials: 'same-origin',
+        headers: { Accept: 'application/json' }
+      });
+      return inspectResponse(response);
+    } catch {
+      return false;
+    }
+  };
+
+  const attachXMLHttpRequest = (XMLHttpRequestClass) => {
+    const prototype = XMLHttpRequestClass?.prototype;
+    if (!prototype || prototype[XHR_PATCHED]) {
+      return;
+    }
+
+    const originalSend = prototype.send;
+    prototype.send = function(...args) {
+      this.addEventListener('loadend', () => inspectResponse(this), {
+        once: true
+      });
+      return originalSend.apply(this, args);
+    };
+    Object.defineProperty(prototype, XHR_PATCHED, { value: true });
+  };
+
+  return {
+    attachXMLHttpRequest,
+    beginReauthentication,
+    checkSession,
+    inspectResponse,
+    wrappedFetch
+  };
+};
+
+let activeController = null;
+
+export const installSsoReauthentication = (windowObject) => {
+  if (activeController) {
+    return activeController;
+  }
+
+  const fetchImpl = windowObject.fetch.bind(windowObject);
+  activeController = createSsoReauthController({
+    fetchImpl,
+    location: windowObject.location,
+    storage: windowObject.sessionStorage
+  });
+
+  windowObject.fetch = activeController.wrappedFetch;
+  activeController.attachXMLHttpRequest(windowObject.XMLHttpRequest);
+  windowObject.addEventListener('focus', () => {
+    void activeController.checkSession();
+  });
+  windowObject.document.addEventListener('visibilitychange', () => {
+    if (windowObject.document.visibilityState === 'visible') {
+      void activeController.checkSession();
+    }
+  });
+
+  return activeController;
+};
+
+export const checkSsoSession = () =>
+  activeController?.checkSession() ?? Promise.resolve(false);
