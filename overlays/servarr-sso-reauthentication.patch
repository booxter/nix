diff --git a/tests/sso-reauth.test.mjs b/tests/sso-reauth.test.mjs
new file mode 100644
--- /dev/null
+++ b/tests/sso-reauth.test.mjs
@@ -0,0 +1,169 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import {
+  createSsoReauthController,
+  isSsoReauthResponse,
+  reauthUrl
+} from '../frontend/src/Utilities/ssoReauthentication.mjs';
+
+const ORIGIN = 'https://arr.example';
+const NOW = 1_000_000;
+
+const response = (status, marker, url = `${ORIGIN}/api/v3/system/status`) => ({
+  headers: { get: (name) => name.toLowerCase() === 'x-sso-reauth' ? marker : null },
+  status,
+  url
+});
+
+const memoryStorage = (initial = {}) => {
+  const values = new Map(Object.entries(initial));
+  return {
+    getItem: (key) => values.get(key) ?? null,
+    removeItem: (key) => values.delete(key),
+    setItem: (key, value) => values.set(key, value),
+    values
+  };
+};
+
+const runtime = ({ fetchImpl = async () => response(200), storage } = {}) => {
+  const navigations = [];
+  const controller = createSsoReauthController({
+    fetchImpl,
+    location: {
+      assign: (url) => navigations.push(url),
+      origin: ORIGIN,
+      pathname: '/settings/general',
+      search: '?apiKey=private'
+    },
+    now: () => NOW,
+    storage: storage ?? memoryStorage()
+  });
+  return { controller, navigations };
+};
+
+test('only a same-origin marked 401 is an SSO response', () => {
+  assert.equal(isSsoReauthResponse(response(401, '1'), ORIGIN), true);
+  assert.equal(isSsoReauthResponse(response(401, null), ORIGIN), false);
+  assert.equal(isSsoReauthResponse(response(403, '1'), ORIGIN), false);
+  assert.equal(
+    isSsoReauthResponse(response(401, '1', 'https://evil.example/'), ORIGIN),
+    false
+  );
+});
+
+test('reauthentication returns to a fixed safe root', () => {
+  assert.equal(
+    reauthUrl(ORIGIN),
+    '/oauth2/start?rd=https%3A%2F%2Farr.example%2F'
+  );
+  assert.equal(reauthUrl(ORIGIN).includes('apiKey'), false);
+});
+
+test('fetch returns the original response and starts one navigation', async () => {
+  const marked = response(401, '1');
+  const { controller, navigations } = runtime({
+    fetchImpl: async () => marked
+  });
+
+  assert.equal(await controller.wrappedFetch('/api/v3/queue'), marked);
+  await controller.wrappedFetch('/api/v3/health');
+  assert.deepEqual(navigations, [reauthUrl(ORIGIN)]);
+});
+
+test('native and cross-origin failures keep their application meaning', () => {
+  const { controller, navigations } = runtime();
+
+  assert.equal(controller.inspectResponse(response(401, null)), false);
+  assert.equal(
+    controller.inspectResponse(
+      response(401, '1', 'https://upstream.example/private')
+    ),
+    false
+  );
+  assert.deepEqual(navigations, []);
+});
+
+test('a recent attempt suppresses a login loop', () => {
+  const storage = memoryStorage({
+    'servarr.sso.reauth-attempt.v1': String(NOW - 1000)
+  });
+  const { controller, navigations } = runtime({ storage });
+
+  assert.equal(controller.inspectResponse(response(401, '1')), true);
+  assert.deepEqual(navigations, []);
+});
+
+test('a successful same-origin response clears the loop guard', () => {
+  const storage = memoryStorage({
+    'servarr.sso.reauth-attempt.v1': String(NOW - 1000)
+  });
+  const { controller } = runtime({ storage });
+
+  controller.inspectResponse(response(202, null, `${ORIGIN}/oauth2/session`));
+  assert.equal(storage.getItem('servarr.sso.reauth-attempt.v1'), null);
+});
+
+test('the session probe uses the fixed same-origin endpoint', async () => {
+  const calls = [];
+  const { controller, navigations } = runtime({
+    fetchImpl: async (...args) => {
+      calls.push(args);
+      return response(401, '1', `${ORIGIN}/oauth2/session`);
+    }
+  });
+
+  assert.equal(await controller.checkSession(), true);
+  assert.equal(calls[0][0], '/oauth2/session');
+  assert.deepEqual(calls[0][1], {
+    cache: 'no-store',
+    credentials: 'same-origin',
+    headers: { Accept: 'application/json' }
+  });
+  assert.deepEqual(navigations, [reauthUrl(ORIGIN)]);
+});
+
+test('network errors from the advisory session probe are ignored', async () => {
+  const { controller, navigations } = runtime({
+    fetchImpl: async () => {
+      throw new Error('offline');
+    }
+  });
+
+  assert.equal(await controller.checkSession(), false);
+  assert.deepEqual(navigations, []);
+});
+
+test('XMLHttpRequest inspection handles marked failures without replay', () => {
+  class FakeXMLHttpRequest {
+    constructor() {
+      this.listeners = new Map();
+      this.responseURL = `${ORIGIN}/api/v3/command`;
+      this.status = 401;
+    }
+
+    addEventListener(name, callback) {
+      this.listeners.set(name, callback);
+    }
+
+    getResponseHeader(name) {
+      return name.toLowerCase() === 'x-sso-reauth' ? '1' : null;
+    }
+
+    send(body) {
+      this.body = body;
+      return 'sent';
+    }
+  }
+
+  const { controller, navigations } = runtime();
+  controller.attachXMLHttpRequest(FakeXMLHttpRequest);
+
+  const xhr = new FakeXMLHttpRequest();
+  assert.equal(xhr.send('private mutation body'), 'sent');
+  xhr.listeners.get('loadend')();
+
+  assert.equal(xhr.body, 'private mutation body');
+  assert.deepEqual(navigations, [reauthUrl(ORIGIN)]);
+  assert.equal(navigations[0].includes('private'), false);
+});
