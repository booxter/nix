diff --git a/lib/lolek/private_video.ex b/lib/lolek/private_video.ex
new file mode 100644
index 0000000..8a69248
--- /dev/null
+++ b/lib/lolek/private_video.ex
@@ -0,0 +1,104 @@
+defmodule Lolek.PrivateVideo do
+  @moduledoc """
+  Links group posts to captionless copies of their videos in the bot's private chat.
+  Link records live in the download cache and survive restarts until cache eviction.
+  """
+
+  require Logger
+
+  @doc "Adds a private-chat link when the post has videos and a bot username is provided."
+  @spec attach(integer(), integer(), [Lolek.File.sent_media_entry()], String.t() | nil) :: :ok
+  def attach(chat_id, message_id, entries, username) when is_binary(username) do
+    video_ids =
+      for {ext, id} <- entries, Lolek.GalleryDownloader.video_file?("x#{ext}") do
+        id
+      end
+
+    case video_ids do
+      [] ->
+        :ok
+
+      ids ->
+        attach_link(chat_id, message_id, ids, username)
+    end
+  end
+
+  def attach(_chat_id, _message_id, _entries, _username), do: :ok
+
+  @doc "Sends the linked videos as ordinary messages without captions."
+  @spec deliver(integer(), String.t()) :: :ok | {:error, term()}
+  def deliver(chat_id, token) do
+    with {:ok, ids} <- read_link(token) do
+      deliver_videos(chat_id, ids)
+    end
+  end
+
+  @spec deliver_videos(integer(), [String.t()]) :: :ok | {:error, term()}
+  defp deliver_videos(_chat_id, []), do: :ok
+
+  defp deliver_videos(chat_id, [id | rest]) do
+    with {:ok, _message} <- Lolek.Telegram.send_video(chat_id, id, []) do
+      deliver_videos(chat_id, rest)
+    end
+  end
+
+  @spec attach_link(integer(), integer(), [String.t()], String.t()) :: :ok
+  defp attach_link(chat_id, message_id, ids, username) do
+    with {:ok, token} <- store_link(ids),
+         button = %ExGram.Model.InlineKeyboardButton{
+           text: if(length(ids) == 1, do: "Get video privately", else: "Get videos privately"),
+           url: "https://t.me/#{username}?start=video_#{token}"
+         },
+         markup = %ExGram.Model.InlineKeyboardMarkup{inline_keyboard: [[button]]},
+         {:ok, _message} <-
+           Lolek.Telegram.edit_message_reply_markup(chat_id, message_id, reply_markup: markup) do
+      :ok
+    else
+      {:error, reason} ->
+        log_link_failure(reason)
+    end
+  rescue
+    error ->
+      log_link_failure(error)
+  end
+
+  @spec store_link([String.t()]) :: {:ok, String.t()} | {:error, term()}
+  defp store_link(ids) do
+    # File IDs exceed Telegram's 64-character start parameter limit. A random
+    # lookup token also keeps unrelated cached videos from being enumerable.
+    token = :crypto.strong_rand_bytes(16) |> Base.url_encode64(padding: false)
+    path = link_path(token)
+
+    with :ok <- File.mkdir_p(Path.dirname(path)),
+         :ok <- File.write(path, Jason.encode!(ids), [:exclusive]) do
+      {:ok, token}
+    end
+  end
+
+  @spec read_link(String.t()) :: {:ok, [String.t()]} | {:error, :expired_link}
+  defp read_link(token) do
+    with true <- Regex.match?(~r/\A[A-Za-z0-9_-]{22}\z/, token),
+         {:ok, json} <- File.read(link_path(token)),
+         {:ok, [_ | _] = ids} <- Jason.decode(json),
+         true <- Enum.all?(ids, &(is_binary(&1) and &1 != "")) do
+      {:ok, ids}
+    else
+      _ ->
+        {:error, :expired_link}
+    end
+  end
+
+  @spec link_path(String.t()) :: String.t()
+  defp link_path(token) do
+    Path.join([
+      Application.fetch_env!(:lolek, :download_path),
+      "private-video-#{token}",
+      "videos.json"
+    ])
+  end
+
+  @spec log_link_failure(term()) :: :ok
+  defp log_link_failure(reason) do
+    Logger.warning("Could not attach private video link: #{inspect(reason)}")
+  end
+end
