+        needsPermissionChange = needsPermissionChange && geteuid() != 0;
+#endif
+        if (needsPermissionChange)
             try {
                 unix::fchmodatTryNoFollow(parentfd, name, st.st_mode | PERM_MASK);
             } catch (SysError & e) {
