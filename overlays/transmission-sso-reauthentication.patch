diff --git a/web/public_html/sso-reauth.js b/web/public_html/sso-reauth.js
new file mode 100644
--- /dev/null
+++ b/web/public_html/sso-reauth.js
@@ -0,0 +1,185 @@
+(function(root, factory) {
+  const api = factory();
+
+  if (typeof module === 'object' && module.exports) {
+    module.exports = api;
+  }
+
+  if (root && root.window === root && typeof root.fetch === 'function') {
+    api.installSsoReauthentication(root);
+  }
+})(typeof globalThis === 'undefined' ? this : globalThis, function() {
+  'use strict';
+
+  const ATTEMPT_KEY = 'browser.sso.reauth-attempt.v1';
+  const REAUTH_HEADER = 'x-sso-reauth';
+  const REAUTH_RETRY_DELAY_MS = 60 * 1000;
+  const SESSION_PATH = '/oauth2/session';
+  const XHR_PATCHED = Symbol('browser.sso.xhr-patched');
+
+  const responseUrl = (response) =>
+    response && (response.url || response.responseURL) || '';
+
+  const responseHeader = (response, name) => {
+    if (response && response.headers &&
+        typeof response.headers.get === 'function') {
+      return response.headers.get(name);
+    }
+    if (response && typeof response.getResponseHeader === 'function') {
+      return response.getResponseHeader(name);
+    }
+    return null;
+  };
+
+  const sameOriginResponse = (response, origin) => {
+    const url = responseUrl(response);
+    if (!url) return false;
+    try {
+      return new URL(url, origin).origin === origin;
+    } catch (_error) {
+      return false;
+    }
+  };
+
+  const isSsoReauthResponse = (response, origin) =>
+    response && response.status === 401 &&
+    responseHeader(response, REAUTH_HEADER) === '1' &&
+    sameOriginResponse(response, origin);
+
+  const reauthUrl = (origin) => {
+    const returnUrl = new URL('/', origin).href;
+    return `/oauth2/start?rd=${encodeURIComponent(returnUrl)}`;
+  };
+
+  const createSsoReauthController = ({
+    fetchImpl,
+    location,
+    storage,
+    now = () => Date.now()
+  }) => {
+    let navigating = false;
+
+    const getStored = (key) => {
+      try {
+        return storage.getItem(key);
+      } catch (_error) {
+        return null;
+      }
+    };
+
+    const removeStored = (key) => {
+      try {
+        storage.removeItem(key);
+      } catch (_error) {
+        // Reauthentication remains safe if storage is unavailable.
+      }
+    };
+
+    const beginReauthentication = () => {
+      if (navigating) return true;
+
+      const attemptedAt = Number(getStored(ATTEMPT_KEY));
+      const age = now() - attemptedAt;
+      if (Number.isFinite(attemptedAt) && attemptedAt > 0 &&
+          age >= 0 && age < REAUTH_RETRY_DELAY_MS) {
+        return true;
+      }
+
+      try {
+        storage.setItem(ATTEMPT_KEY, String(now()));
+      } catch (_error) {
+        // Only the persisted loop guard is lost.
+      }
+
+      navigating = true;
+      location.assign(reauthUrl(location.origin));
+      return true;
+    };
+
+    const inspectResponse = (response) => {
+      if (isSsoReauthResponse(response, location.origin)) {
+        return beginReauthentication();
+      }
+      if (!navigating && response && response.status >= 200 &&
+          response.status < 400 && sameOriginResponse(response, location.origin)) {
+        removeStored(ATTEMPT_KEY);
+      }
+      return false;
+    };
+
+    const wrappedFetch = async (input, init) => {
+      const response = await fetchImpl(input, init);
+      inspectResponse(response);
+      return response;
+    };
+
+    const checkSession = async () => {
+      try {
+        const response = await fetchImpl(SESSION_PATH, {
+          cache: 'no-store',
+          credentials: 'same-origin',
+          headers: { Accept: 'application/json' }
+        });
+        return inspectResponse(response);
+      } catch (_error) {
+        return false;
+      }
+    };
+
+    const attachXMLHttpRequest = (XMLHttpRequestClass) => {
+      const prototype = XMLHttpRequestClass && XMLHttpRequestClass.prototype;
+      if (!prototype || prototype[XHR_PATCHED]) return;
+
+      const originalSend = prototype.send;
+      prototype.send = function(...args) {
+        this.addEventListener('loadend', () => inspectResponse(this), {
+          once: true
+        });
+        return originalSend.apply(this, args);
+      };
+      Object.defineProperty(prototype, XHR_PATCHED, { value: true });
+    };
+
+    return {
+      attachXMLHttpRequest,
+      beginReauthentication,
+      checkSession,
+      inspectResponse,
+      wrappedFetch
+    };
+  };
+
+  const installSsoReauthentication = (windowObject) => {
+    if (windowObject.__browserSsoReauthentication) {
+      return windowObject.__browserSsoReauthentication;
+    }
+
+    const controller = createSsoReauthController({
+      fetchImpl: windowObject.fetch.bind(windowObject),
+      location: windowObject.location,
+      storage: windowObject.sessionStorage
+    });
+    windowObject.__browserSsoReauthentication = controller;
+    windowObject.fetch = controller.wrappedFetch;
+    controller.attachXMLHttpRequest(windowObject.XMLHttpRequest);
+    windowObject.addEventListener('focus', () => {
+      void controller.checkSession();
+    });
+    if (windowObject.document) {
+      windowObject.document.addEventListener('visibilitychange', () => {
+        if (windowObject.document.visibilityState === 'visible') {
+          void controller.checkSession();
+        }
+      });
+    }
+    return controller;
+  };
+
+  return {
+    createSsoReauthController,
+    installSsoReauthentication,
+    isSsoReauthResponse,
+    reauthUrl,
+    sameOriginResponse
+  };
+});
