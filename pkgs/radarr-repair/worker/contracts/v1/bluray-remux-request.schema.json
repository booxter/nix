{
  "$defs": {
    "source": {
      "additionalProperties": false,
      "properties": {
        "expected_fingerprint": {
          "$ref": "wire-types.schema.json#/$defs/sha256Id"
        },
        "path_components": {
          "items": {
            "$ref": "wire-types.schema.json#/$defs/pathComponent"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        },
        "size_bytes": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "path_components",
        "expected_fingerprint",
        "size_bytes"
      ],
      "type": "object"
    },
    "track": {
      "additionalProperties": false,
      "properties": {
        "codec": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "video",
            "audio",
            "subtitles"
          ]
        },
        "language": {
          "maxLength": 32,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "codec",
        "language"
      ],
      "type": "object"
    }
  },
  "$id": "bluray-remux-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capability_id": {
      "$ref": "wire-types.schema.json#/$defs/opaqueId"
    },
    "case_id": {
      "$ref": "wire-types.schema.json#/$defs/sha256Id"
    },
    "clips": {
      "items": {
        "$ref": "#/$defs/source"
      },
      "maxItems": 1024,
      "minItems": 1,
      "type": "array"
    },
    "execution_id": {
      "$ref": "wire-types.schema.json#/$defs/opaqueId"
    },
    "expected_chapter_count": {
      "maximum": 4096,
      "minimum": 0,
      "type": "integer"
    },
    "expected_duration_ms": {
      "maximum": 604800000,
      "minimum": 1,
      "type": "integer"
    },
    "expected_tracks": {
      "items": {
        "$ref": "#/$defs/track"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    },
    "operation": {
      "const": "stage_bluray_remux_v1"
    },
    "playlist": {
      "$ref": "#/$defs/source"
    },
    "request_id": {
      "$ref": "wire-types.schema.json#/$defs/opaqueId"
    },
    "root_id": {
      "$ref": "wire-types.schema.json#/$defs/opaqueId"
    },
    "schema_version": {
      "const": "radarr-repair-worker/v1"
    }
  },
  "required": [
    "schema_version",
    "operation",
    "request_id",
    "execution_id",
    "case_id",
    "capability_id",
    "root_id",
    "playlist",
    "clips",
    "expected_duration_ms",
    "expected_chapter_count",
    "expected_tracks"
  ],
  "title": "Radarr repair worker Blu-ray remux stage request",
  "type": "object"
}
