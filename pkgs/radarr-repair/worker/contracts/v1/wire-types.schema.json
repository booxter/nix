{
  "$defs": {
    "opaqueId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_:-]*$",
      "type": "string"
    },
    "pathComponent": {
      "maxLength": 255,
      "minLength": 1,
      "not": {
        "enum": [
          ".",
          ".."
        ]
      },
      "pattern": "^[^/\\\\\\x00-\\x1f\\x7f]+$",
      "type": "string"
    },
    "sha256Id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "wire-types.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Radarr repair worker shared wire types version 1"
}
