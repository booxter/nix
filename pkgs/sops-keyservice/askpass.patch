diff --git a/age/askpass_test.go b/age/askpass_test.go
new file mode 100644
--- /dev/null
+++ b/age/askpass_test.go
@@ -0,0 +1,34 @@
+package age
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestPluginAskpass(t *testing.T) {
+	for _, test := range []struct {
+		name string
+		body string
+		want string
+		fail bool
+	}{
+		{"answer", "printf '123456\\n'", "123456", false},
+		{"cancel", "exit 1", "", true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			program := filepath.Join(t.TempDir(), "askpass")
+			if err := os.WriteFile(program, []byte("#!/bin/sh\n"+test.body+"\n"), 0700); err != nil {
+				t.Fatal(err)
+			}
+			t.Setenv("SOPS_AGE_ASKPASS", program)
+			answer, err := pluginTerminalUI.RequestValue("yubikey", "PIN", true)
+			if (err != nil) != test.fail {
+				t.Fatalf("unexpected prompt error: %v", err)
+			}
+			if answer != test.want {
+				t.Fatal("unexpected prompt response")
+			}
+		})
+	}
+}
