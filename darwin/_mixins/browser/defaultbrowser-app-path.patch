 #import <Foundation/Foundation.h>
 #import <ApplicationServices/ApplicationServices.h>
+#import <AppKit/AppKit.h>
+#import <dispatch/dispatch.h>
 
+int set_default_app(NSString *path) {
+    if (![path isAbsolutePath]) {
+        fprintf(stderr, "Expected an absolute application path: %s\n", path.UTF8String);
+        return 1;
+    }
+
+    NSURL *appURL = [NSURL fileURLWithPath:[path stringByStandardizingPath]];
+    if ([NSBundle bundleWithURL:appURL].bundleIdentifier == nil) {
+        fprintf(stderr, "Not an application bundle: %s\n", path.UTF8String);
+        return 1;
+    }
+
+    NSWorkspace *workspace = [NSWorkspace sharedWorkspace];
+    for (NSString *scheme in @[@"http", @"https"]) {
+        NSURL *probeURL = [NSURL URLWithString:[scheme stringByAppendingString:@"://example.com"]];
+        NSURL *selectedURL = [workspace URLForApplicationToOpenURL:probeURL];
+        if ([selectedURL.path.stringByStandardizingPath isEqualToString:appURL.path]) {
+            continue;
+        }
+
+        __block NSError *failure = nil;
+
+        [workspace setDefaultApplicationAtURL:appURL
+                        toOpenURLsWithScheme:scheme
+                           completionHandler:^(NSError *error) {
+            // Keep completion state on the main thread while servicing consent UI.
+            dispatch_async(dispatch_get_main_queue(), ^{
+                failure = error;
+                CFRunLoopStop(CFRunLoopGetMain());
+            });
+        }];
+
+        // The callback stops this run loop after any consent dialog completes.
+        CFRunLoopRun();
+
+        if (failure != nil) {
+            fprintf(stderr, "Cannot set %s handler: %s\n",
+                    scheme.UTF8String, failure.localizedDescription.UTF8String);
+            return 1;
+        }
+
+        // A matching bundle ID alone does not distinguish installed Firefox copies.
+        selectedURL = [workspace URLForApplicationToOpenURL:probeURL];
+        if (![selectedURL.path.stringByStandardizingPath isEqualToString:appURL.path]) {
+            fprintf(stderr, "%s resolved to %s instead of %s\n",
+                    scheme.UTF8String, selectedURL.path.UTF8String ?: "(none)",
+                    appURL.path.UTF8String);
+            return 1;
+        }
+    }
+
+    return 0;
+}
+
 NSString* app_name_from_bundle_id(NSString *app_bundle_id) {
     return [[[app_bundle_id componentsSeparatedByString:@"."] lastObject] lowercaseString];
 }
