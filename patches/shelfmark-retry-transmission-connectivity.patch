+
+                    # Transmission reports temporary RPC outages as error statuses. Keep the
+                    # queue item alive so polling resumes when the daemon becomes responsive.
+                    retryable_transmission_error = (
+                        client.name == "transmission"
+                        and message.startswith(
+                            (
+                                "TransmissionConnectError:",
+                                "TransmissionTimeoutError:",
+                            )
+                        )
+                    )
+                    if retryable_transmission_error:
+                        logger.warning(
+                            "Transmission temporarily unavailable while polling %s: %s",
+                            download_id,
+                            message,
+                        )
+                        status_callback("resolving", "Waiting for Transmission...")
