diff --git a/tests/libtransmission/open-files-test.cc b/tests/libtransmission/open-files-test.cc
index 7d4cbaebf..3cec5078c 100644
--- a/tests/libtransmission/open-files-test.cc
+++ b/tests/libtransmission/open-files-test.cc
@@ -28,6 +28,28 @@ using OpenFilesTest = libtransmission::test::SessionTest;
 
 static auto constexpr PreallocateFull = tr_open_files::Preallocation::Full;
 
+class ConfiguredOpenFilesTest : public OpenFilesTest
+{
+protected:
+    void SetUp() override
+    {
+        settings()->get_if<tr_variant::Map>()->insert_or_assign(TR_KEY_open_file_limit, 40);
+        OpenFilesTest::SetUp();
+    }
+};
+
+TEST_F(ConfiguredOpenFilesTest, keepsConfiguredNumberOfFilesOpen)
+{
+    for (int i = 0; i <= 40; ++i)
+    {
+        auto const filename = tr_pathbuf{ sandboxDir(), fmt::format("/file-{}.txt", i) };
+        ASSERT_TRUE(session_->openFiles().get(0, i, true, filename, PreallocateFull, 0));
+    }
+
+    EXPECT_FALSE(session_->openFiles().get(0, 0, false));
+    EXPECT_TRUE(session_->openFiles().get(0, 1, false));
+}
