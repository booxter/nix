diff --git a/ssh-device-pin.h b/ssh-device-pin.h
new file mode 100644
--- /dev/null
+++ b/ssh-device-pin.h
@@ -0,0 +1,19 @@
+/* The resolver reads PIN policy from the same manifest used for device
+ * selection. If it cannot confirm the policy, keep the touch notification.
+ */
+static int
+ssh_device_pin_first(struct sshkey *key, const char *provider, char *fp)
+{
+	char *argv[] = { "@resolver@/bin/ssh-device", "pin-first", fp, NULL };
+	pid_t pid;
+
+	if (provider == NULL || strcmp(provider, "internal") != 0 ||
+	    sshkey_is_cert(key) || !(key->sk_flags & SSH_SK_USER_VERIFICATION_REQD))
+		return 0;
+
+	/* argv[0] is the immutable Nix store path of the configured helper. */
+	pid = subprocess("SSH PIN policy", argv[0], 3, argv, NULL,
+	    SSH_SUBPROCESS_STDOUT_DISCARD | SSH_SUBPROCESS_UNSAFE_PATH,
+	    NULL, NULL, NULL);
+	return pid > 0 && exited_cleanly(pid, "SSH PIN policy", argv[0], 1) == 0;
+}
