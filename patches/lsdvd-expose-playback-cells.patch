diff --git a/oxml.c b/oxml.c
--- a/oxml.c
+++ b/oxml.c
@@ -211,6 +211,15 @@ void oxml_print(struct dvd_info *dvd_info) {
 				XMLBOX("cell");
 				XMLDEF("ix", "%d", i+1);
