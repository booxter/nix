+/// Usage across all model calls in one turn, measured from session totals.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct TurnTokenUsage {
+    pub(crate) input_tokens: i64,
+    pub(crate) output_tokens: i64,
+}
+
+impl TurnTokenUsage {
+    pub(crate) fn since(total: &TokenUsage, start: &TokenUsage) -> Self {
+        Self {
+            input_tokens: total.input_tokens.saturating_sub(start.input_tokens).max(0),
+            output_tokens: total
+                .output_tokens
+                .saturating_sub(start.output_tokens)
+                .max(0),
+        }
+    }
+
+    pub(crate) fn label(self) -> String {
+        format!(
+            "{} in · {} out",
+            crate::status::format_tokens_compact(self.input_tokens),
+            crate::status::format_tokens_compact(self.output_tokens),
+        )
+    }
+}
