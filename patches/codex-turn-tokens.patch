+fn report_turn_tokens(chat: &mut ChatWidget, turn_id: &str, input: i64, output: i64) {
+    let usage = codex_app_server_protocol::TokenUsageBreakdown {
+        input_tokens: input,
+        output_tokens: output,
+        total_tokens: input + output,
+        cached_input_tokens: 0,
+        cache_write_input_tokens: 0,
+        reasoning_output_tokens: 0,
+    };
+    chat.handle_server_notification(
+        ServerNotification::ThreadTokenUsageUpdated(
+            codex_app_server_protocol::ThreadTokenUsageUpdatedNotification {
+                thread_id: chat.thread_id.map(|id| id.to_string()).unwrap_or_default(),
+                turn_id: turn_id.to_string(),
+                token_usage: codex_app_server_protocol::ThreadTokenUsage {
+                    total: usage.clone(),
+                    last: usage,
+                    model_context_window: Some(200_000),
+                },
+            },
+        ),
+        /*replay_kind*/ None,
+    );
+}
+
+#[tokio::test]
+async fn turn_tokens_accumulate_across_calls_and_reset_for_the_next_turn() {
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    report_turn_tokens(&mut chat, "previous", 50_000, 100);
+    handle_turn_started(&mut chat, "turn-1");
+    assert!(!render_bottom_first_row(&chat, 200).contains("tokens"));
+
+    report_turn_tokens(&mut chat, "turn-1", 60_000, 300);
+    assert!(render_bottom_first_row(&chat, 200).contains("↓ 200 tokens"));
+    report_turn_tokens(&mut chat, "turn-1", 60_000, 300);
+    report_turn_tokens(&mut chat, "turn-1", 62_000, 940);
+    assert!(render_bottom_first_row(&chat, 200).contains("↓ 840 tokens"));
+
+    complete_turn(&mut chat, completed_turn(Some(35_000), Some(COMPLETED_AT)));
+    let label = completion_labels(&mut rx);
+    assert!(
+        label.starts_with("Worked for 35s • 12K in · 840 out • "),
+        "{label}"
+    );
+
+    handle_turn_started(&mut chat, "turn-2");
+    assert!(!render_bottom_first_row(&chat, 200).contains("tokens"));
+    report_turn_tokens(&mut chat, "turn-2", 63_000, 945);
+    assert!(render_bottom_first_row(&chat, 200).contains("↓ 5 tokens"));
+    handle_turn_completed(&mut chat, "turn-2", Some(1_000));
+    let label = completion_labels(&mut rx);
+    assert!(label.contains("1K in · 5 out"), "{label}");
+}
+
+#[tokio::test]
+async fn turn_tokens_survive_status_recreation_and_ignore_other_turns() {
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    handle_turn_started(&mut chat, "turn-1");
+    report_turn_tokens(&mut chat, "turn-1", 12_000, 840);
+    report_turn_tokens(&mut chat, "previous", 100, 1);
+    chat.bottom_pane.hide_status_indicator();
+    chat.bottom_pane.ensure_status_indicator();
+    chat.bottom_pane
+        .set_unified_exec_processes(vec!["sleep 10".to_string()]);
+    let row = render_bottom_first_row(&chat, 200);
+    assert!(row.contains("↓ 840 tokens"), "{row}");
+    assert!(row.contains("background"), "{row}");
+
+    complete_turn(&mut chat, completed_turn(Some(35_000), Some(COMPLETED_AT)));
+    let label = completion_labels(&mut rx);
+    assert!(label.contains("12K in · 840 out"), "{label}");
+
+    handle_turn_started(&mut chat, "turn-2");
+    report_turn_tokens(&mut chat, "turn-2", 13_000, 845);
+    handle_turn_completed(&mut chat, "turn-2", Some(1_000));
+    let label = completion_labels(&mut rx);
+    assert!(label.contains("1K in · 5 out"), "{label}");
+}
+
+#[tokio::test]
+async fn turn_tokens_are_omitted_when_unknown_or_restored() {
+    for restored in [false, true] {
+        let (mut chat, mut rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+        if restored {
+            chat.handle_server_notification(
+                ServerNotification::TurnStarted(TurnStartedNotification {
+                    thread_id: String::new(),
+                    turn: app_server_turn("turn-1", AppServerTurnStatus::InProgress, None, None),
+                }),
+                Some(ReplayKind::ThreadSnapshot),
+            );
+            report_turn_tokens(&mut chat, "turn-1", 12_000, 840);
+        } else {
+            handle_turn_started(&mut chat, "turn-1");
+        }
+        assert!(!render_bottom_first_row(&chat, 200).contains("tokens"));
+        complete_turn(&mut chat, completed_turn(Some(35_000), Some(COMPLETED_AT)));
+        let label = completion_labels(&mut rx);
+        assert!(label.starts_with("Worked for 35s • "), "{label}");
+        assert!(!label.contains(" in · "), "{label}");
+    }
+}
