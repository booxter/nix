@@ -0,0 +1,88 @@
+"""Restart recovery for downloads managed by external clients."""
+
+from threading import Event
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+from shelfmark.core.models import DownloadTask
+from shelfmark.release_sources.prowlarr.handler import ProwlarrHandler
+
+
+def _callbacks():
+    statuses = []
+    return (
+        (lambda _progress: None),
+        (lambda status, message: statuses.append((status, message))),
+        statuses,
+    )
+
+
+def test_bound_download_reattaches_without_resolving_source(monkeypatch):
+    client = SimpleNamespace(name="transmission")
+    handler = ProwlarrHandler()
+    poll_calls = []
+    resolve_download = MagicMock(side_effect=AssertionError("source was resolved"))
+    monkeypatch.setattr(handler, "_get_client", lambda _protocol: client)
+    monkeypatch.setattr(handler, "_resolve_download", resolve_download)
+    monkeypatch.setattr(
+        handler,
+        "_poll_and_complete",
+        lambda **kwargs: poll_calls.append(kwargs) or "/tmp/complete",
+    )
+    task = DownloadTask(
+        task_id="t1",
+        source="prowlarr",
+        title="Example",
+        external_download_client="transmission",
+        external_download_id="abc123",
+        external_download_protocol="torrent",
+    )
+    progress, status, statuses = _callbacks()
+
+    result = handler.download(task, Event(), progress, status)
+
+    assert result == "/tmp/complete"
+    resolve_download.assert_not_called()
+    assert poll_calls[0]["download_id"] == "abc123"
+    assert ("resolving", "Reattaching to transmission") in statuses
+
+
+def test_new_external_download_binding_is_persisted_before_poll(monkeypatch):
+    client = SimpleNamespace(
+        name="transmission",
+        handoff_only=False,
+        find_existing=lambda _url, category=None: None,
+        add_download=lambda **_kwargs: "abc123",
+    )
+    handler = ProwlarrHandler()
+    poll_calls = []
+    request = SimpleNamespace(
+        url="magnet:?xt=urn:btih:fresh",
+        protocol="torrent",
+        release_name="Example",
+        expected_hash=None,
+        seeding_time_limit=None,
+        ratio_limit=None,
+    )
+    monkeypatch.setattr(handler, "_get_client", lambda _protocol: client)
+    monkeypatch.setattr(handler, "_resolve_download", lambda *_args, **_kwargs: request)
+    monkeypatch.setattr(
+        handler,
+        "_poll_and_complete",
+        lambda **kwargs: poll_calls.append(kwargs) or "/tmp/complete",
+    )
+    task = DownloadTask(task_id="t1", source="prowlarr", title="Example")
+    changed = []
+    monkeypatch.setattr(
+        "shelfmark.download.clients.base_handler.book_queue.notify_task_changed",
+        changed.append,
+    )
+    progress, status, _statuses = _callbacks()
+
+    result = handler.download(task, Event(), progress, status)
+
+    assert result == "/tmp/complete"
+    assert task.external_download_client == "transmission"
+    assert task.external_download_id == "abc123"
