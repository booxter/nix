+package main
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/getsops/sops/v3"
+	"github.com/getsops/sops/v3/aes"
+	"github.com/getsops/sops/v3/cmd/sops/common"
+	"github.com/getsops/sops/v3/config"
+	"github.com/getsops/sops/v3/decrypt"
+	"github.com/getsops/sops/v3/keyservice"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/credentials/insecure"
+)
+
+// A configured service is authoritative: never fall back to guest identities.
+func decryptFile(path, format string) ([]byte, error) {
+	endpoint := os.Getenv("SOPS_KEYSERVICE")
+	if endpoint == "" {
+		return decrypt.File(path, format)
+	}
+	if !strings.HasPrefix(endpoint, "unix:///") {
+		return nil, fmt.Errorf("SOPS_KEYSERVICE must be an absolute unix:/// socket URL")
+	}
+
+	// The socket is private; SSH provides authentication and encryption between hosts.
+	connection, err := grpc.NewClient(endpoint, grpc.WithTransportCredentials(insecure.NewCredentials()))
+	if err != nil {
+		return nil, err
+	}
+	defer connection.Close()
+
+	store := common.DefaultStoreForPathOrFormat(config.NewStoresConfig(), path, format)
+	tree, err := common.LoadEncryptedFile(store, path)
+	if err != nil {
+		return nil, err
+	}
+	_, err = common.DecryptTree(common.DecryptTreeOpts{
+		Tree: tree,
+		KeyServices: []keyservice.KeyServiceClient{
+			boundedKeyService{keyservice.NewKeyServiceClient(connection)},
+		},
+		Cipher:          aes.NewCipher(),
+		DecryptionOrder: sops.DefaultDecryptionOrder,
+	})
+	if err != nil {
+		return nil, err
+	}
+	return store.EmitPlainFile(tree.Branches)
+}
+
+type boundedKeyService struct {
+	keyservice.KeyServiceClient
+}
+
+func (client boundedKeyService) Decrypt(ctx context.Context, request *keyservice.DecryptRequest, options ...grpc.CallOption) (*keyservice.DecryptResponse, error) {
+	// Allow time for hardware approval without hanging activation indefinitely.
+	ctx, cancel := context.WithTimeout(ctx, 2*time.Minute)
+	defer cancel()
+	return client.KeyServiceClient.Decrypt(ctx, request, options...)
+}
