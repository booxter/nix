+package main
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"filippo.io/age"
+	"filippo.io/age/armor"
+	"github.com/getsops/sops/v3/keyservice"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+type fixtureKeyService struct {
+	keyservice.Server
+	identities []age.Identity
+	deny       bool
+	requests   *atomic.Int32
+}
+
+func (service fixtureKeyService) Decrypt(_ context.Context, request *keyservice.DecryptRequest) (*keyservice.DecryptResponse, error) {
+	service.requests.Add(1)
+	if service.deny {
+		return nil, status.Error(codes.PermissionDenied, "hardware approval denied")
+	}
+	reader, err := age.Decrypt(armor.NewReader(bytes.NewReader(request.Ciphertext)), service.identities...)
+	if err != nil {
+		return nil, err
+	}
+	plaintext, err := io.ReadAll(reader)
+	if err != nil {
+		return nil, err
+	}
+	return &keyservice.DecryptResponse{Plaintext: plaintext}, nil
+}
+
+func startFixtureKeyService(t *testing.T, deny bool) (string, *atomic.Int32) {
+	t.Helper()
+	identity, err := os.ReadFile(filepath.Join(testAssetPath(), "age-keys.txt"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	identities, err := age.ParseIdentities(bytes.NewReader(identity))
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Darwin's Unix socket path limit is shorter than many test temp paths.
+	directory, err := os.MkdirTemp("/tmp", "sops-rpc-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.RemoveAll(directory) })
+	socket := filepath.Join(directory, "service.sock")
+	listener, err := net.Listen("unix", socket)
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := grpc.NewServer()
+	requests := new(atomic.Int32)
+	keyservice.RegisterKeyServiceServer(server, fixtureKeyService{identities: identities, deny: deny, requests: requests})
+	go server.Serve(listener)
+	t.Cleanup(server.Stop)
+	return "unix://" + socket, requests
+}
+
+func TestRemoteDecryptionWithoutLocalIdentity(t *testing.T) {
+	endpoint, requests := startFixtureKeyService(t, false)
+	t.Setenv("SOPS_KEYSERVICE", endpoint)
+	t.Setenv("SOPS_AGE_KEY_FILE", filepath.Join(t.TempDir(), "absent"))
+	t.Setenv("SOPS_AGE_KEY", "")
+	filename := filepath.Join(testAssetPath(), "secrets.yaml")
+	secrets := []secret{
+		{SopsFile: filename, Format: Yaml, Key: "test_key"},
+		{SopsFile: filename, Format: Yaml},
+		{SopsFile: filename, Format: Yaml, Key: "test_key"},
+	}
+	if err := decryptSecrets(secrets); err != nil {
+		t.Fatal(err)
+	}
+	if string(secrets[0].value) != "test_value" || string(secrets[2].value) != "test_value" || !bytes.Contains(secrets[1].value, []byte("test_key:")) {
+		t.Fatal("remote decryption produced the wrong secret")
+	}
+	if requests.Load() != 1 {
+		t.Fatalf("one document required %d decryption approvals", requests.Load())
+	}
+}
+
+func TestRemoteDecryptionFailsClosed(t *testing.T) {
+	// Even a valid local identity must not bypass remote failure or denial.
+	t.Setenv("SOPS_AGE_KEY_FILE", filepath.Join(testAssetPath(), "age-keys.txt"))
+	denied, _ := startFixtureKeyService(t, true)
+	for _, endpoint := range []string{
+		denied,
+		"unix:///nonexistent-sops-vm-prototype.sock",
+		"tcp://127.0.0.1:1234",
+	} {
+		t.Run(endpoint, func(t *testing.T) {
+			t.Setenv("SOPS_KEYSERVICE", endpoint)
+			if _, err := decryptFile(filepath.Join(testAssetPath(), "secrets.yaml"), "yaml"); err == nil {
+				t.Fatal("decryption succeeded without an authorized remote service")
+			}
+		})
+	}
+}
+
+func TestRemoteDecryptionUnconfiguredPreservesLocalDecryption(t *testing.T) {
+	t.Setenv("SOPS_KEYSERVICE", "")
+	t.Setenv("SOPS_AGE_KEY_FILE", filepath.Join(testAssetPath(), "age-keys.txt"))
+	secret := secret{SopsFile: filepath.Join(testAssetPath(), "secrets.yaml"), Format: Yaml, Key: "test_key"}
+	if err := decryptSecret(&secret, make(map[string]plainData)); err != nil {
+		t.Fatal(err)
+	}
+	if string(secret.value) != "test_value" {
+		t.Fatal("local decryption produced the wrong secret")
+	}
+}
+
+func TestRemoteDecryptionRejectsTampering(t *testing.T) {
+	endpoint, _ := startFixtureKeyService(t, false)
+	t.Setenv("SOPS_KEYSERVICE", endpoint)
+	data, err := os.ReadFile(filepath.Join(testAssetPath(), "secrets.yaml"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	filename := filepath.Join(t.TempDir(), "tampered.yaml")
+	data = []byte(strings.Replace(string(data), "test_key:", "changed_key:", 1))
+	if err := os.WriteFile(filename, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := decryptFile(filename, "yaml"); err == nil {
+		t.Fatal("accepted a document with a changed authenticated key")
+	}
+}
