diff --git a/.tests/settings/managed-slskd.test.js b/.tests/settings/managed-slskd.test.js
new file mode 100644
index 0000000..284feb4
--- /dev/null
+++ b/.tests/settings/managed-slskd.test.js
@@ -0,0 +1,114 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+
+import {
+  applyManagedSlskdSettings,
+  getManagedSlskdSettings,
+  preserveStoredSlskdSettings,
+} from "../../backend/config/managedSlskd.js";
+
+const managedEnvironment = {
+  AURRAL_SLSKD_MANAGED: "true",
+  AURRAL_SLSKD_URL: "http://127.0.0.2:5030",
+  AURRAL_SLSKD_API_KEY: "test-api-key",
+  AURRAL_SLSKD_PRIORITY: "20",
+  AURRAL_SLSKD_CLEANUP_AFTER_RUNS: "true",
+};
+
+test("managed slskd settings are disabled by default", () => {
+  assert.equal(getManagedSlskdSettings({}), null);
+});
+
+test("managed slskd settings require a URL", () => {
+  assert.throws(
+    () =>
+      getManagedSlskdSettings({
+        AURRAL_SLSKD_MANAGED: "true",
+        AURRAL_SLSKD_API_KEY: "test-api-key",
+      }),
+    /AURRAL_SLSKD_URL is required/,
+  );
+});
+
+test("managed slskd settings require an API key", () => {
+  assert.throws(
+    () =>
+      getManagedSlskdSettings({
+        AURRAL_SLSKD_MANAGED: "true",
+        AURRAL_SLSKD_URL: "http://127.0.0.2:5030",
+      }),
+    /AURRAL_SLSKD_API_KEY is required/,
+  );
+});
+
+for (const priority of ["0", "1001", "invalid"]) {
+  test(`managed slskd rejects priority ${priority}`, () => {
+    assert.throws(
+      () =>
+        getManagedSlskdSettings({
+          ...managedEnvironment,
+          AURRAL_SLSKD_PRIORITY: priority,
+        }),
+      /AURRAL_SLSKD_PRIORITY must be between 1 and 1000/,
+    );
+  });
+}
+
+test("managed slskd settings replace only the slskd integration", () => {
+  const result = applyManagedSlskdSettings(
+    {
+      slskd: { apiKey: "stored-api-key" },
+      ytdlp: { enabled: true },
+    },
+    managedEnvironment,
+  );
+
+  assert.deepEqual(result, {
+    slskd: {
+      enabled: true,
+      url: "http://127.0.0.2:5030",
+      apiKey: "test-api-key",
+      priority: 20,
+      cleanupAfterRuns: true,
+      managed: true,
+    },
+    ytdlp: { enabled: true },
+  });
+});
+
+test("stored slskd settings are preserved when saving managed settings", () => {
+  const result = preserveStoredSlskdSettings(
+    {
+      slskd: { apiKey: "managed-api-key" },
+      ytdlp: { enabled: true },
+    },
+    { slskd: { apiKey: "stored-api-key" } },
+    managedEnvironment,
+  );
+
+  assert.deepEqual(result, {
+    slskd: { apiKey: "stored-api-key" },
+    ytdlp: { enabled: true },
+  });
+});
+
+test("managed slskd settings are not persisted when none were stored", () => {
+  const result = preserveStoredSlskdSettings(
+    {
+      slskd: { apiKey: "managed-api-key" },
+      ytdlp: { enabled: true },
+    },
+    {},
+    managedEnvironment,
+  );
+
+  assert.deepEqual(result, { ytdlp: { enabled: true } });
+});
+
+test("unmanaged slskd settings are persisted normally", () => {
+  const integrations = { slskd: { apiKey: "updated-api-key" } };
+  assert.deepEqual(
+    preserveStoredSlskdSettings(integrations, {}, {}),
+    integrations,
+  );
+});
diff --git a/backend/config/managedSlskd.js b/backend/config/managedSlskd.js
new file mode 100644
index 0000000..9548bb2
--- /dev/null
+++ b/backend/config/managedSlskd.js
@@ -0,0 +1,53 @@
+function parseBoolean(value) {
+  return String(value || "").trim().toLowerCase() === "true";
+}
+
+function parsePriority(value) {
+  const parsed = Number.parseInt(value, 10);
+  if (!Number.isFinite(parsed) || parsed < 1 || parsed > 1000) {
+    throw new Error("AURRAL_SLSKD_PRIORITY must be between 1 and 1000");
+  }
+  return parsed;
+}
+
+export function getManagedSlskdSettings(env = process.env) {
+  if (!parseBoolean(env.AURRAL_SLSKD_MANAGED)) return null;
+
+  const url = String(env.AURRAL_SLSKD_URL || "").trim();
+  const apiKey = String(env.AURRAL_SLSKD_API_KEY || "").trim();
+  if (!url) throw new Error("AURRAL_SLSKD_URL is required for managed slskd");
+  if (!apiKey) {
+    throw new Error("AURRAL_SLSKD_API_KEY is required for managed slskd");
+  }
+
+  return {
+    enabled: true,
+    url,
+    apiKey,
+    priority: parsePriority(env.AURRAL_SLSKD_PRIORITY || "10"),
+    cleanupAfterRuns: parseBoolean(env.AURRAL_SLSKD_CLEANUP_AFTER_RUNS),
+    managed: true,
+  };
+}
+
+export function applyManagedSlskdSettings(integrations, env = process.env) {
+  const managed = getManagedSlskdSettings(env);
+  if (!managed) return integrations;
+  return { ...integrations, slskd: managed };
+}
+
+export function preserveStoredSlskdSettings(
+  integrations,
+  storedIntegrations,
+  env = process.env,
+) {
+  if (!getManagedSlskdSettings(env)) return integrations;
+
+  const preserved = { ...integrations };
+  if (storedIntegrations.slskd === undefined) {
+    delete preserved.slskd;
+  } else {
+    preserved.slskd = storedIntegrations.slskd;
+  }
+  return preserved;
+}
