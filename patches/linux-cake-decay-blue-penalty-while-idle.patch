+/* Catch up BLUE decay when an idle flow receives another packet.  Only
+ * uninterrupted empty time counts; blue_timer excludes decrements already
+ * performed by the scheduler and any later overflow notification.
+ */
+static bool cobalt_idle_decay(struct cobalt_vars *vars,
+			      struct cobalt_params *p, ktime_t now)
+{
+	ktime_t start = max(vars->empty_since, vars->blue_timer);
+	u64 periods, decrement;
+	s64 elapsed;
+
+	if (!vars->empty_since || !vars->p_drop)
+		return false;
+
+	elapsed = ktime_to_ns(ktime_sub(now, start));
+	if (elapsed <= 0)
+		return false;
+
+	periods = div64_u64(elapsed, p->target);
+	/* Saturate before multiplication, including after very long idle times. */
+	decrement = min_t(u64, periods, U32_MAX) * p->p_dec;
+	vars->p_drop -= min_t(u64, vars->p_drop, decrement);
+	if (periods)
+		vars->blue_timer = now;
+
+	return !vars->p_drop;
+}
