+class _BoundedRunEventQueue(asyncio.Queue):
+    """Retain pending run events while bounding their aggregate memory use."""
+
+    def __init__(self, *, max_events: int, max_bytes: int) -> None:
+        super().__init__()
+        self._max_events = max_events
+        self._max_bytes = max_bytes
+        self._buffered_bytes = 0
+
+    @staticmethod
+    def _item_size(item: Optional[Dict]) -> int:
+        if item is None:
+            return 0
+        encoded = json.dumps(
+            item,
+            ensure_ascii=False,
+            default=str,
+            separators=(",", ":"),
+        ).encode()
+        return len(encoded)
+
+    @staticmethod
+    def _dropped(item: Optional[Dict], size: int) -> tuple[int, int]:
+        if isinstance(item, dict) and item.get("event") == "stream.truncated":
+            return (
+                int(item.get("dropped_events", 0)),
+                int(item.get("dropped_bytes", 0)),
+            )
+        return (0, 0) if item is None else (1, size)
+
+    @staticmethod
+    def _truncation_event(dropped_events: int, dropped_bytes: int) -> Dict:
+        return {
+            "event": "stream.truncated",
+            "dropped_events": dropped_events,
+            "dropped_bytes": dropped_bytes,
+        }
+
+    def _put(self, item: Optional[Dict]) -> None:
+        dropped_events = 0
+        dropped_bytes = 0
+
+        if (
+            self._queue
+            and isinstance(self._queue[0], dict)
+            and self._queue[0].get("event") == "stream.truncated"
+        ):
+            old_marker = self._queue.popleft()
+            old_marker_size = self._item_size(old_marker)
+            self._buffered_bytes -= old_marker_size
+            dropped_events, dropped_bytes = self._dropped(
+                old_marker, old_marker_size
+            )
+
+        item_size = self._item_size(item)
+        # Leave enough room to report that an individual event was discarded.
+        if item is not None and item_size > self._max_bytes - 1024:
+            new_events, new_bytes = self._dropped(item, item_size)
+            dropped_events += new_events
+            dropped_bytes += new_bytes
+        else:
+            self._queue.append(item)
+            self._buffered_bytes += item_size
+
+        while self._queue:
+            marker = self._truncation_event(dropped_events, dropped_bytes)
+            marker_size = self._item_size(marker) if dropped_events else 0
+            if (
+                len(self._queue) + bool(dropped_events) <= self._max_events
+                and self._buffered_bytes + marker_size <= self._max_bytes
+            ):
+                break
+            old_item = self._queue.popleft()
+            old_size = self._item_size(old_item)
+            self._buffered_bytes -= old_size
+            new_events, new_bytes = self._dropped(old_item, old_size)
+            dropped_events += new_events
+            dropped_bytes += new_bytes
+
+        if dropped_events:
+            marker = self._truncation_event(dropped_events, dropped_bytes)
+            self._queue.appendleft(marker)
+            self._buffered_bytes += self._item_size(marker)
+
+    def _get(self) -> Optional[Dict]:
+        item = self._queue.popleft()
+        self._buffered_bytes -= self._item_size(item)
+        return item
 
 
