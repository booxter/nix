From: NixOS deployment patch
Subject: [PATCH] preserve run event streams across client reconnects

Keep a run's transport queue when its sole SSE subscriber disconnects so a
replacement client can resume watching it. Bound the retained queue with the
existing orphan TTL, and reject concurrent subscribers because they would
otherwise split events from the single queue.

---
 gateway/platforms/api_server_runs.py | 17 +++++++++++++++--
 1 file changed, 15 insertions(+), 2 deletions(-)

diff --git a/gateway/platforms/api_server_runs.py b/gateway/platforms/api_server_runs.py
--- a/gateway/platforms/api_server_runs.py
+++ b/gateway/platforms/api_server_runs.py
@@ -1098,8 +1098,15 @@ async def _handle_run_events(
     else:
         return web.json_response(_openai_error(f"Run not found: {run_id}", code="run_not_found"), status=404)
 
+    if run_id in self._run_stream_subscribers:
+        return web.json_response(
+            _openai_error("Run event stream already has a subscriber", code="run_stream_in_use"),
+            status=409,
+        )
+
     q = self._run_streams[run_id]
     self._run_stream_subscribers.add(run_id)
+    stream_completed = False
 
     response = web.StreamResponse(
         status=200,
@@ -1111,6 +1118,7 @@ async def _handle_run_events(
         },
     )
     await response.prepare(request)
+    await response.write(b": connected\n\n")
 
     try:
         while True:
@@ -1121,6 +1129,7 @@ async def _handle_run_events(
                 continue
             if event is None:
                 # Run finished — send final SSE comment and close
+                stream_completed = True
                 await response.write(b": stream closed\n\n")
                 break
             payload = _sse_frame(event)
@@ -1128,9 +1137,13 @@ async def _handle_run_events(
     except Exception as exc:
         logger.debug("[api_server] SSE stream error for run %s: %s", run_id, exc)
     finally:
         self._run_stream_subscribers.discard(run_id)
-        self._run_streams.pop(run_id, None)
-        self._run_streams_created.pop(run_id, None)
+        if stream_completed:
+            self._run_streams.pop(run_id, None)
+            self._run_streams_created.pop(run_id, None)
+        elif self._run_streams.get(run_id) is q:
+            # Give a replacement client a fresh TTL window to reconnect.
+            self._run_streams_created[run_id] = time.time()
 
     return response
 
