+    def recovery_block_capacity(self, setname: str, nzf: NzbFile) -> Optional[int]:
+        """Upper bound on blocks this volume could supply to the requested set."""
+        par2pack = self.par2packs.get(setname)
+        if not par2pack:
+            return None
+
+        blocksize = next(iter(par2pack.values())).blocksize
+        if not blocksize:
+            return None
+
+        file_sizes = [
+            article.file_size
+            for article in nzf.decodetable
+            if article.file_size is not None and article.crc32 is not None
+        ]
+        if not file_sizes:
+            return None
+
+        # Use full yEnc sizes, including gaps in an incomplete NZB. Taking the
+        # largest keeps an upper bound if headers disagree. Each recovery
+        # packet needs a 64-byte header and a four-byte exponent.
+        return max(file_sizes) // (blocksize + 68)
+
