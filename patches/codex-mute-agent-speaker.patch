+#[test]
+fn speaker_mute_hint_follows_binding_and_preserves_existing_controls() {
+    let mut strip = active_strip();
+    strip.state.speaker_muted = true;
+    for (binding, expected) in [
+        ("", "f10 unmute agent"),
+        (
+            "toggle_voice_speaker_mute = 'ctrl-x s'",
+            "⌃x s unmute agent",
+        ),
+        ("toggle_voice_speaker_mute = []", ""),
+        ("toggle_voice_mute = 'f10'", ""),
+        ("toggle_voice_mute = 'f10 m'", ""),
+    ] {
+        let config = toml::from_str(&format!("[chat]\n{binding}")).unwrap();
+        let chat = crate::keymap::RuntimeKeymap::from_config(&config)
+            .unwrap()
+            .chat;
+        strip.state.mute_hint = chat.voice_mute_hint();
+        strip.state.speaker_mute_hint = chat.voice_speaker_mute_hint();
+        let (text, _) = rows(&strip, /*width*/ 80);
+        let status = text.lines().next().unwrap();
+        assert_eq!(status.split_once("/voice stop").unwrap().1.trim(), expected);
+        let (text, _) = rows(&strip, /*width*/ 47);
+        assert!(text.contains("voice ●") && text.contains("/voice stop"));
+        assert!(!text.contains("mute agent"));
+    }
+}
