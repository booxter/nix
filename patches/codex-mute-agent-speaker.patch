+    let answer = agent_item("final", "Final answer", Some(MessagePhase::FinalAnswer));
+    start_item(&mut chat, thread_id, turn_id, answer.clone());
+    complete_item(&mut chat, thread_id, turn_id, answer.clone());
+    finish_turn(
+        &mut chat,
+        thread_id,
+        turn_id,
+        vec![answer],
+        TurnStatus::Completed,
+    );
+
+    assert!(chat.realtime_microphone_is_listening());
+    assert!(ops.try_recv().is_err());
+    let rendered = history_text(&mut events);
+    assert_eq!(rendered.matches("Final answer").count(), 1, "{rendered}");
+    assert!(!rendered.contains("Earlier guess"), "{rendered}");
+}
