+#[cfg(test)]
+mod tests {
+    use super::GenerationRate;
+
+    #[test]
+    fn rate_weights_responses_by_server_time() {
+        let mut rate = GenerationRate::default();
+        assert_eq!(rate.tokens_per_second(), None);
+
+        rate.record(200, 1_000);
+        assert_eq!(rate.tokens_per_second(), Some(200.0));
+
+        rate.record(400, 5_000);
+        assert_eq!(rate.tokens_per_second(), Some(100.0));
+    }
+
+    #[test]
+    fn invalid_samples_do_not_distort_the_rate() {
+        let mut rate = GenerationRate::default();
+        rate.record(50_000, 0);
+        rate.record(-1, 1_000);
+        assert_eq!(rate.tokens_per_second(), None);
+
+        rate.record(200, 1_000);
+        rate.record(50_000, 0);
+        rate.record(-1, 1_000);
+        assert_eq!(rate.tokens_per_second(), Some(200.0));
+
+        rate.record(0, 1_000);
+        assert_eq!(rate.tokens_per_second(), Some(100.0));
+    }
