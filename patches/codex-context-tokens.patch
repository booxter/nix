@@ -0,0 +1,56 @@
+/// Output tokens divided by server processing time, including service overhead
+/// and excluding client tools, network transit, and pauses between user turns.
+/// Only responses with both usage and timing contribute to the average.
+#[derive(Debug, Default)]
+pub(crate) struct GenerationRate {
+    output_tokens: u64,
+    duration_ms: u64,
+}
+
+impl GenerationRate {
+    pub(crate) fn record(&mut self, output_tokens: i64, duration_ms: u64) {
+        if output_tokens < 0 || duration_ms == 0 {
+            return;
+        }
+
+        self.output_tokens = self.output_tokens.saturating_add(output_tokens as u64);
+        self.duration_ms = self.duration_ms.saturating_add(duration_ms);
+    }
+
+    pub(crate) fn tokens_per_second(&self) -> Option<f64> {
+        (self.duration_ms > 0).then(|| self.output_tokens as f64 * 1000.0 / self.duration_ms as f64)
+    }
+}
