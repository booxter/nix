 #[tokio::test]
+async fn status_line_distinguishes_context_from_session_tokens() {
+    let (mut chat, _rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.token_info = Some(TokenUsageInfo {
+        total_token_usage: TokenUsage {
+            input_tokens: 900_000,
+            output_tokens: 100_000,
+            total_tokens: 1_000_000,
+            ..Default::default()
+        },
+        last_token_usage: TokenUsage {
+            total_tokens: 24_000,
+            ..Default::default()
+        },
+        model_context_window: Some(108_000),
+    });
+    chat.local_settings.tui.status_line = Some(vec![
+        "context-remaining".to_string(),
+        "total-input-tokens".to_string(),
+        "total-output-tokens".to_string(),
+    ]);
+
+    chat.refresh_status_line();
+
+    assert_eq!(
+        status_line_text(&chat),
+        Some("Context 24K tokens, 88% left · 900K in · 100K out".to_string())
+    );
+}
