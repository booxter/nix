+#[tokio::test]
+async fn context_status_shows_session_generation_rate_for_measured_responses() {
+    let (mut chat, _rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.token_info = Some(TokenUsageInfo {
+        total_token_usage: TokenUsage::default(),
+        last_token_usage: TokenUsage::default(),
+        model_context_window: Some(108_000),
+    });
+    chat.local_settings.tui.status_line = Some(vec!["context-remaining".to_string()]);
+    chat.refresh_status_line();
+    assert!(!status_line_text(&chat).unwrap().contains("tk/s"));
+
+    let completed = |response_id: &str, output_tokens, service_duration_ms| {
+        ServerNotification::RawResponseCompleted(
+            codex_app_server_protocol::RawResponseCompletedNotification {
+                thread_id: String::new(),
+                turn_id: "turn-1".to_string(),
+                response_id: response_id.to_string(),
+                usage: Some(codex_app_server_protocol::TokenUsageBreakdown {
+                    input_tokens: 0,
+                    output_tokens,
+                    total_tokens: output_tokens,
+                    cached_input_tokens: 0,
+                    cache_write_input_tokens: 0,
+                    reasoning_output_tokens: 0,
+                }),
+                usage_metadata: None,
+                service_duration_ms,
+            },
+        )
+    };
+
+    chat.handle_server_notification(completed("first", 200, Some(1_000)), None);
+    assert!(status_line_text(&chat).unwrap().ends_with(", 200.0 tk/s"));
+
+    // Starting another turn retains the weighted session average, rather than
+    // averaging individual response rates or dividing by wall-clock session age.
+    handle_turn_started(&mut chat, "turn-2");
