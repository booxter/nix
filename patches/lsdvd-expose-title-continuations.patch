+/* Only a straight, single-chain title establishes a playback relationship. */
+static int sequential_playback(const pgc_t *pgc, const ttu_t *parts)
+{
+	if (!pgc->cell_playback || !pgc->program_map || !pgc->nr_of_programs ||
+	    !pgc->nr_of_cells || pgc->pg_playback_mode || pgc->still_time ||
+	    parts->nr_of_ptts != pgc->nr_of_programs || pgc->program_map[0] != 1)
+		return 0;
+
+	for (int i = 0; i < parts->nr_of_ptts; i++) {
+		if (parts->ptt[i].pgcn != parts->ptt[0].pgcn || parts->ptt[i].pgn != i + 1 ||
+		    pgc->program_map[i] > pgc->nr_of_cells ||
+		    (i && pgc->program_map[i] <= pgc->program_map[i - 1]))
+			return 0;
+	}
+	for (int i = 0; i < pgc->nr_of_cells; i++) {
+		const cell_playback_t *cell = &pgc->cell_playback[i];
+		if (cell->block_type != BLOCK_TYPE_NONE || cell->cell_cmd_nr ||
+		    cell->first_sector > cell->last_sector)
+			return 0;
+	}
+	return 1;
+}
