+using FluentAssertions;
+using NUnit.Framework;
+using NzbDrone.Core.MediaFiles.MovieImport;
+using Radarr.Api.V3.ManualImport;
+
+namespace NzbDrone.Api.Test.v3.ManualImport
+{
+    [TestFixture]
+    public class ManualImportResourceMapperFixture
+    {
+        [Test]
+        public void should_expose_machine_readable_rejection_reason()
+        {
+            var rejection = new ImportRejection(
+                ImportRejectionReason.NotQualityUpgrade,
+                "Not an upgrade for existing movie file");
+
+            var resource = rejection.ToResource();
+
+            resource.ReasonCode.Should().Be(ImportRejectionReason.NotQualityUpgrade);
+            resource.Reason.Should().Be("Not an upgrade for existing movie file");
+        }
+    }
+}
