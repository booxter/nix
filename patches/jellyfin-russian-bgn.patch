+        private static void RegisterRussianBgnTransliterator()
+        {
+            // ICU4N 60.1 omits this CLDR transform. Register it before resolving the configured ID.
+            using var rules = typeof(StringExtensions).Assembly.GetManifestResourceStream("Jellyfin.Extensions.RussianLatinBgn.xml")
+                ?? throw new InvalidOperationException("Russian BGN transliteration rules are missing.");
+            var document = XDocument.Load(rules);
+            Transliterator.RegisterInstance(Transliterator.CreateFromRules(
+                "Russian-Latin/BGN",
+                document.Descendants("tRule").Single().Value,
+                TransliterationDirection.Forward));
+        }
