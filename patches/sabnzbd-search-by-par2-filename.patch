+def par2_search_pattern(parfile: str, nzo: NzbObject, setname: str) -> str:
+    if len(nzo.extrapars) == 1:
+        return "*"
+
+    folder, filename = os.path.split(parfile)
+    prefix, _, _ = analyse_par2(filename)
+    matches = globber(folder, glob.escape(prefix) + "*")
+    if len(matches) < 2:
+        return "*"
+
+    if prefix != setname:
+        # An ID-keyed set used to get a directory-wide search. Its targets
+        # are read from the index, but an unclaimed file can also hold blocks.
+        accounted_for = set(matches)
+        for key, pack in nzo.par2packs.items():
+            if pack:
+                accounted_for.update(pack)
+                if key != setname:
+                    accounted_for.update(nzf.filename for nzf in nzo.extrapars.get(key, ()))
+
+        with os.scandir(folder) as entries:
+            if any(entry.name not in accounted_for and entry.is_file() for entry in entries):
+                return "*"
+
+    return prefix + "*"
+
+
