+++ b/tests/test_par2_search_pattern.py
@@ -0,0 +1,32 @@
+from pathlib import Path
+from tempfile import TemporaryDirectory
+from unittest import TestCase
+
+from sabnzbd.newsunpack import par2_search_pattern
+from sabnzbd.nzb import NzbObject
+from sabnzbd.par2file import FilePar2Info
+
+
+class TestPar2SearchPattern(TestCase):
+    def test_top_level_donor_with_same_name_as_nested_target(self):
+        job = NzbObject("Bundle.nzb")
+        set_id = "a" * 32
+        job.extrapars = {"Bundle": [], set_id: []}
+        job.par2packs = {
+            "Bundle": {"nested/spare.bin": FilePar2Info("nested/spare.bin", b"", 0)},
+            set_id: {"episode.bin": FilePar2Info("episode.bin", b"", 0)},
+        }
+
+        with TemporaryDirectory() as tmp:
+            folder = Path(tmp)
+            volume = folder / "Bundle.vol002+01.par2"
+            for name in (volume.name, "Bundle.par2", "episode.bin"):
+                (folder / name).touch()
+
+            pattern = par2_search_pattern(str(volume), job, set_id)
+            self.assertEqual(set(folder.glob(pattern)), {volume, folder / "Bundle.par2"})
+
+            donor = folder / "spare.bin"
+            donor.touch()
+            pattern = par2_search_pattern(str(volume), job, set_id)
+            self.assertIn(donor, folder.glob(pattern))
