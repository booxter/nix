diff --git a/src/client/utils/sso-reauth.ts b/src/client/utils/sso-reauth.ts
new file mode 100644
index 0000000..afb002e
--- /dev/null
+++ b/src/client/utils/sso-reauth.ts
@@ -0,0 +1,268 @@
+const PENDING_VERSION = 1;
+const PENDING_KEY = "degoog.sso.pending-navigation.v1";
+const ATTEMPT_KEY = "degoog.sso.reauth-attempt.v1";
+const MAX_PENDING_AGE_MS = 5 * 60 * 1000;
+const MAX_PENDING_BYTES = 16 * 1024;
+const REAUTH_RETRY_DELAY_MS = 60 * 1000;
+const REAUTH_HEADER = "x-sso-reauth";
+const SESSION_PATH = "/oauth2/session";
+const SEARCH_PARAMETERS = new Set([
+  "q",
+  "type",
+  "page",
+  "imgColor",
+  "imgSize",
+  "imgType",
+  "imgLayout",
+  "safeMode",
+]);
+
+interface LocationLike {
+  origin: string;
+  pathname: string;
+  search: string;
+  hash: string;
+  assign(url: string): void;
+  replace(url: string): void;
+}
+
+interface StorageLike {
+  getItem(key: string): string | null;
+  removeItem(key: string): void;
+  setItem(key: string, value: string): void;
+}
+
+interface ResponseLike {
+  status: number;
+  url: string;
+  headers: Pick<Headers, "get">;
+}
+
+interface PendingNavigation {
+  version: number;
+  createdAt: number;
+  origin: string;
+  method: "GET";
+  path: string;
+}
+
+interface ReauthControllerOptions {
+  fetchImpl: typeof fetch;
+  location: LocationLike;
+  storage: StorageLike;
+  now?: () => number;
+}
+
+const sameOriginResponse = (response: ResponseLike, origin: string): boolean => {
+  if (!response.url) return false;
+  try {
+    return new URL(response.url, origin).origin === origin;
+  } catch {
+    return false;
+  }
+};
+
+export const isSsoReauthResponse = (
+  response: ResponseLike,
+  origin: string,
+): boolean =>
+  response.status === 401 &&
+  response.headers.get(REAUTH_HEADER) === "1" &&
+  sameOriginResponse(response, origin);
+
+export const reauthUrl = (origin: string): string => {
+  const returnUrl = new URL("/", origin).href;
+  return `/oauth2/start?rd=${encodeURIComponent(returnUrl)}`;
+};
+
+const safeNavigationPath = (
+  location: Pick<LocationLike, "pathname" | "search">,
+): string => {
+  if (location.pathname === "/search") {
+    const parameters = new URLSearchParams(location.search);
+    if ([...parameters.keys()].some((key) => !SEARCH_PARAMETERS.has(key))) {
+      return "/";
+    }
+    return `${location.pathname}${location.search}`;
+  }
+  if (
+    location.pathname === "/settings" ||
+    location.pathname.startsWith("/settings/")
+  ) {
+    return location.pathname;
+  }
+  return "/";
+};
+
+export const pendingNavigationFor = (
+  location: Pick<LocationLike, "origin" | "pathname" | "search">,
+  createdAt = Date.now(),
+): PendingNavigation => ({
+  version: PENDING_VERSION,
+  createdAt,
+  origin: location.origin,
+  method: "GET",
+  path: safeNavigationPath(location),
+});
+
+export const parsePendingNavigation = (
+  raw: string,
+  origin: string,
+  now = Date.now(),
+): PendingNavigation | null => {
+  if (raw.length > MAX_PENDING_BYTES) return null;
+
+  try {
+    const pending = JSON.parse(raw) as Partial<PendingNavigation>;
+    if (
+      pending.version !== PENDING_VERSION ||
+      !Number.isFinite(pending.createdAt) ||
+      pending.createdAt! > now + REAUTH_RETRY_DELAY_MS ||
+      now - pending.createdAt! > MAX_PENDING_AGE_MS ||
+      pending.origin !== origin ||
+      pending.method !== "GET" ||
+      typeof pending.path !== "string"
+    ) {
+      return null;
+    }
+
+    const target = new URL(pending.path, `${origin}/`);
+    if (target.origin !== origin || target.hash) return null;
+    if (safeNavigationPath(target) !== `${target.pathname}${target.search}`) {
+      return null;
+    }
+
+    return {
+      version: PENDING_VERSION,
+      createdAt: pending.createdAt!,
+      origin,
+      method: "GET",
+      path: `${target.pathname}${target.search}`,
+    };
+  } catch {
+    return null;
+  }
+};
+
+export const createSsoReauthController = ({
+  fetchImpl,
+  location,
+  storage,
+  now = Date.now,
+}: ReauthControllerOptions) => {
+  let navigating = false;
+
+  const getStored = (key: string): string | null => {
+    try {
+      return storage.getItem(key);
+    } catch {
+      return null;
+    }
+  };
+
+  const removeStored = (key: string): void => {
+    try {
+      storage.removeItem(key);
+    } catch {
+      // Storage can be disabled without making reauthentication unsafe.
+    }
+  };
+
+  const beginReauthentication = (): boolean => {
+    if (navigating) return true;
+
+    const attemptedAt = Number(getStored(ATTEMPT_KEY));
+    const age = now() - attemptedAt;
+    if (
+      Number.isFinite(attemptedAt) &&
+      attemptedAt > 0 &&
+      age >= 0 &&
+      age < REAUTH_RETRY_DELAY_MS
+    ) {
+      return false;
+    }
+
+    try {
+      storage.setItem(
+        PENDING_KEY,
+        JSON.stringify(pendingNavigationFor(location, now())),
+      );
+      storage.setItem(ATTEMPT_KEY, String(now()));
+    } catch {
+      // Reauthentication is still safe when sessionStorage is unavailable;
+      // only restoration and the persisted loop guard are lost.
+    }
+
+    navigating = true;
+    location.assign(reauthUrl(location.origin));
+    return true;
+  };
+
+  const inspectResponse = (response: ResponseLike): boolean => {
+    if (isSsoReauthResponse(response, location.origin)) {
+      return beginReauthentication();
+    }
+    if (!navigating && sameOriginResponse(response, location.origin)) {
+      removeStored(ATTEMPT_KEY);
+    }
+    return false;
+  };
+
+  const wrappedFetch: typeof fetch = async (input, init) => {
+    const response = await fetchImpl(input, init);
+    inspectResponse(response);
+    return response;
+  };
+
+  const reauthenticateIfSessionExpired = async (): Promise<boolean> => {
+    try {
+      const response = await fetchImpl(SESSION_PATH, {
+        cache: "no-store",
+        credentials: "same-origin",
+        headers: { Accept: "application/json" },
+      });
+      return inspectResponse(response);
+    } catch {
+      return false;
+    }
+  };
+
+  const restorePendingNavigation = (): boolean => {
+    const raw = getStored(PENDING_KEY);
+    if (raw === null) return false;
+    removeStored(PENDING_KEY);
+
+    const pending = parsePendingNavigation(raw, location.origin, now());
+    const atFixedReturnPage =
+      location.pathname === "/" && location.search === "" && location.hash === "";
+    if (!pending || !atFixedReturnPage || pending.path === "/") return false;
+
+    location.replace(pending.path);
+    return true;
+  };
+
+  return {
+    reauthenticateIfSessionExpired,
+    restorePendingNavigation,
+    wrappedFetch,
+  };
+};
+
+let controller: ReturnType<typeof createSsoReauthController> | null = null;
+
+export const installSsoReauthentication = (): boolean => {
+  if (controller) return false;
+
+  controller = createSsoReauthController({
+    fetchImpl: window.fetch.bind(window),
+    location: window.location,
+    storage: window.sessionStorage,
+  });
+
+  if (controller.restorePendingNavigation()) return true;
+  window.fetch = controller.wrappedFetch;
+  return false;
+};
+
+export const reauthenticateIfSsoSessionExpired = async (): Promise<boolean> =>
+  controller?.reauthenticateIfSessionExpired() ?? false;
