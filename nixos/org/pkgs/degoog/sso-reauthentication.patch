diff --git a/tests/public/sso-reauth.test.ts b/tests/public/sso-reauth.test.ts
new file mode 100644
index 0000000..7bc446d
--- /dev/null
+++ b/tests/public/sso-reauth.test.ts
@@ -0,0 +1,222 @@
+import { describe, expect, test } from "bun:test";
+import {
+  createSsoReauthController,
+  isSsoReauthResponse,
+  parsePendingNavigation,
+  pendingNavigationFor,
+  reauthUrl,
+} from "../../src/client/utils/sso-reauth";
+
+const ORIGIN = "https://goo.example";
+const NOW = 1_800_000_000_000;
+
+const response = (
+  status: number,
+  url = `${ORIGIN}/api/search`,
+  marker?: string,
+): Response =>
+  ({
+    status,
+    url,
+    headers: new Headers(marker === undefined ? {} : { "X-SSO-Reauth": marker }),
+  }) as Response;
+
+const memoryStorage = (initial: Record<string, string> = {}) => {
+  const values = new Map(Object.entries(initial));
+  return {
+    getItem: (key: string) => values.get(key) ?? null,
+    removeItem: (key: string) => values.delete(key),
+    setItem: (key: string, value: string) => values.set(key, value),
+    values,
+  };
+};
+
+const runtime = (
+  nextResponse: Response,
+  path = "/search?q=private+query",
+  storage = memoryStorage(),
+) => {
+  const target = new URL(path, ORIGIN);
+  const assigned: string[] = [];
+  const replaced: string[] = [];
+  const requests: Array<[RequestInfo | URL, RequestInit | undefined]> = [];
+  const fetchImpl: typeof fetch = async (input, init) => {
+    requests.push([input, init]);
+    return nextResponse;
+  };
+  const controller = createSsoReauthController({
+    fetchImpl,
+    location: {
+      origin: ORIGIN,
+      pathname: target.pathname,
+      search: target.search,
+      hash: target.hash,
+      assign: (url) => assigned.push(url),
+      replace: (url) => replaced.push(url),
+    },
+    storage,
+    now: () => NOW,
+  });
+  return { assigned, controller, replaced, requests, storage };
+};
+
+describe("SSO reauthentication response detection", () => {
+  test("requires the exact proxy marker on a same-origin 401", () => {
+    expect(isSsoReauthResponse(response(401, undefined, "1"), ORIGIN)).toBe(true);
+    expect(isSsoReauthResponse(response(403, undefined, "1"), ORIGIN)).toBe(false);
+    expect(isSsoReauthResponse(response(401, undefined, "true"), ORIGIN)).toBe(false);
+    expect(isSsoReauthResponse(response(401), ORIGIN)).toBe(false);
+    expect(
+      isSsoReauthResponse(response(401, "https://evil.example/", "1"), ORIGIN),
+    ).toBe(false);
+  });
+});
+
+describe("SSO pending navigation", () => {
+  test("retains only reviewed search state", () => {
+    expect(
+      pendingNavigationFor(
+        {
+          origin: ORIGIN,
+          pathname: "/search",
+          search: "?q=private+query&type=images",
+        },
+        NOW,
+      ),
+    ).toEqual({
+      version: 1,
+      createdAt: NOW,
+      origin: ORIGIN,
+      method: "GET",
+      path: "/search?q=private+query&type=images",
+    });
+
+    expect(
+      pendingNavigationFor(
+        { origin: ORIGIN, pathname: "/settings/server", search: "?token=secret" },
+        NOW,
+      ).path,
+    ).toBe("/settings/server");
+    expect(
+      pendingNavigationFor(
+        { origin: ORIGIN, pathname: "/api/unknown", search: "?token=secret" },
+        NOW,
+      ).path,
+    ).toBe("/");
+    expect(
+      pendingNavigationFor(
+        { origin: ORIGIN, pathname: "/search", search: "?token=secret" },
+        NOW,
+      ).path,
+    ).toBe("/");
+  });
+
+  test("rejects stale, cross-origin, unsafe, and unreviewed state", () => {
+    const valid = pendingNavigationFor(
+      { origin: ORIGIN, pathname: "/search", search: "?q=test" },
+      NOW,
+    );
+    expect(parsePendingNavigation(JSON.stringify(valid), ORIGIN, NOW)).toEqual(valid);
+    expect(
+      parsePendingNavigation(JSON.stringify(valid), ORIGIN, NOW + 5 * 60 * 1000 + 1),
+    ).toBeNull();
+    expect(
+      parsePendingNavigation(JSON.stringify({ ...valid, origin: "https://evil.example" }), ORIGIN, NOW),
+    ).toBeNull();
+    expect(
+      parsePendingNavigation(JSON.stringify({ ...valid, method: "POST" }), ORIGIN, NOW),
+    ).toBeNull();
+    expect(
+      parsePendingNavigation(JSON.stringify({ ...valid, path: "/settings?token=secret" }), ORIGIN, NOW),
+    ).toBeNull();
+  });
+});
+
+describe("SSO reauthentication controller", () => {
+  test("navigates through a fixed safe URL without replaying the request", async () => {
+    const ctx = runtime(response(401, undefined, "1"));
+    const result = await ctx.controller.wrappedFetch(`${ORIGIN}/api/search`, {
+      method: "POST",
+      body: "private body",
+    });
+
+    expect(result.status).toBe(401);
+    expect(ctx.requests).toHaveLength(1);
+    expect(ctx.assigned).toEqual([reauthUrl(ORIGIN)]);
+    expect(ctx.assigned[0]).not.toContain("private");
+
+    const pendingRaw = [...ctx.storage.values.entries()].find(([key]) =>
+      key.includes("pending-navigation"),
+    )?.[1];
+    expect(pendingRaw).toBeDefined();
+    expect(parsePendingNavigation(pendingRaw!, ORIGIN, NOW)?.path).toBe(
+      "/search?q=private+query",
+    );
+  });
+
+  test("preserves native and cross-origin 401 behavior", async () => {
+    const native = runtime(response(401));
+    await native.controller.wrappedFetch(`${ORIGIN}/api/search`);
+    expect(native.assigned).toEqual([]);
+
+    const foreign = runtime(response(401, "https://evil.example/", "1"));
+    await foreign.controller.wrappedFetch("https://evil.example/");
+    expect(foreign.assigned).toEqual([]);
+  });
+
+  test("probes the session before an opaque transport", async () => {
+    const ctx = runtime(response(401, `${ORIGIN}/oauth2/session`, "1"));
+    expect(await ctx.controller.reauthenticateIfSessionExpired()).toBe(true);
+    expect(ctx.requests).toEqual([
+      [
+        "/oauth2/session",
+        {
+          cache: "no-store",
+          credentials: "same-origin",
+          headers: { Accept: "application/json" },
+        },
+      ],
+    ]);
+    expect(ctx.assigned).toEqual([reauthUrl(ORIGIN)]);
+  });
+
+  test("refuses a second reauthentication attempt inside the loop guard", async () => {
+    const storage = memoryStorage({ "degoog.sso.reauth-attempt.v1": String(NOW) });
+    const ctx = runtime(response(401, undefined, "1"), "/search?q=test", storage);
+    await ctx.controller.wrappedFetch(`${ORIGIN}/api/search`);
+    expect(ctx.assigned).toEqual([]);
+  });
+
+  test("still reauthenticates when sessionStorage is unavailable", async () => {
+    const storage = {
+      getItem: () => {
+        throw new Error("storage disabled");
+      },
+      removeItem: () => {
+        throw new Error("storage disabled");
+      },
+      setItem: () => {
+        throw new Error("storage disabled");
+      },
+      values: new Map<string, string>(),
+    };
+    const ctx = runtime(response(401, undefined, "1"), "/search?q=test", storage);
+    await ctx.controller.wrappedFetch(`${ORIGIN}/api/search`);
+    expect(ctx.assigned).toEqual([reauthUrl(ORIGIN)]);
+  });
+
+  test("restores validated state once only from the fixed return page", () => {
+    const pending = pendingNavigationFor(
+      { origin: ORIGIN, pathname: "/search", search: "?q=test" },
+      NOW,
+    );
+    const storage = memoryStorage({
+      "degoog.sso.pending-navigation.v1": JSON.stringify(pending),
+    });
+    const ctx = runtime(response(202), "/", storage);
+
+    expect(ctx.controller.restorePendingNavigation()).toBe(true);
+    expect(ctx.replaced).toEqual(["/search?q=test"]);
+    expect(ctx.controller.restorePendingNavigation()).toBe(false);
+  });
+});
