diff --git a/tests/sso-reauth.test.cjs b/tests/sso-reauth.test.cjs
new file mode 100644
index 0000000..4e57368
--- /dev/null
+++ b/tests/sso-reauth.test.cjs
@@ -0,0 +1,255 @@
+const assert = require('node:assert/strict')
+const { readFileSync } = require('node:fs')
+const test = require('node:test')
+const vm = require('node:vm')
+
+const {
+    createSsoReauthController,
+    isSsoReauthResponse,
+    parsePendingNavigation,
+    pendingNavigationFor,
+    reauthUrl,
+} = require('../src/web/static/sso-reauth.js')
+
+const NOW = 1_800_000_000_000
+const ORIGIN = 'https://tg.example'
+
+const response = (
+    status,
+    { marker, ok = status >= 200 && status < 300, url = `${ORIGIN}/api/chats` } = {},
+) => ({
+    status,
+    ok,
+    url,
+    headers: {
+        get(name) {
+            return name.toLowerCase() === 'x-sso-reauth' ? marker ?? null : null
+        },
+    },
+})
+
+class MemoryStorage {
+    constructor() {
+        this.values = new Map()
+    }
+
+    getItem(key) {
+        return this.values.has(key) ? this.values.get(key) : null
+    }
+
+    removeItem(key) {
+        this.values.delete(key)
+    }
+
+    setItem(key, value) {
+        this.values.set(key, value)
+    }
+}
+
+const runtime = ({
+    fetchResponse = response(200),
+    storage = new MemoryStorage(),
+} = {}) => {
+    const assigned = []
+    const requests = []
+    const location = {
+        origin: ORIGIN,
+        assign(url) {
+            assigned.push(url)
+        },
+    }
+    const fetchImpl = async (input, init) => {
+        requests.push([input, init])
+        return typeof fetchResponse === 'function'
+            ? fetchResponse(input, init)
+            : fetchResponse
+    }
+    const controller = createSsoReauthController({
+        fetchImpl,
+        location,
+        storage,
+        now: () => NOW,
+    })
+    return { assigned, controller, requests, storage }
+}
+
+test('detects only a marked same-origin 401', () => {
+    assert.equal(
+        isSsoReauthResponse(response(401, { marker: '1' }), ORIGIN),
+        true,
+    )
+    assert.equal(isSsoReauthResponse(response(401), ORIGIN), false)
+    assert.equal(
+        isSsoReauthResponse(response(401, { marker: '0' }), ORIGIN),
+        false,
+    )
+    assert.equal(
+        isSsoReauthResponse(response(403, { marker: '1' }), ORIGIN),
+        false,
+    )
+    assert.equal(
+        isSsoReauthResponse(response(401, {
+            marker: '1',
+            url: 'https://id.example/ui/oauth2',
+        }), ORIGIN),
+        false,
+    )
+})
+
+test('uses a fixed safe reauthentication target', () => {
+    const url = reauthUrl(ORIGIN)
+    assert.equal(
+        url,
+        '/oauth2/start?rd=https%3A%2F%2Ftg.example%2F',
+    )
+    assert.equal(url.includes('/api/'), false)
+    assert.equal(url.includes('chat'), false)
+})
+
+test('stores only reviewed read-only navigation state', () => {
+    assert.deepEqual(
+        pendingNavigationFor({
+            chatId: -1001451286149,
+            topicId: 42,
+            query: 'private search',
+            method: 'DELETE',
+        }, ORIGIN, NOW),
+        {
+            version: 1,
+            createdAt: NOW,
+            origin: ORIGIN,
+            method: 'GET',
+            path: '/',
+            chatId: -1001451286149,
+            topicId: 42,
+        },
+    )
+})
+
+test('validates origin, age, method, path, and identifiers', () => {
+    const valid = pendingNavigationFor({ chatId: -1001, topicId: 9 }, ORIGIN, NOW)
+    assert.deepEqual(
+        parsePendingNavigation(JSON.stringify(valid), ORIGIN, NOW),
+        valid,
+    )
+
+    for (const override of [
+        { origin: 'https://evil.example' },
+        { createdAt: NOW - 5 * 60 * 1000 - 1 },
+        { method: 'POST' },
+        { path: '/api/chats/-1001/messages' },
+        { chatId: 'private' },
+        { chatId: null, topicId: 9 },
+    ]) {
+        assert.equal(
+            parsePendingNavigation(
+                JSON.stringify({ ...valid, ...override }),
+                ORIGIN,
+                NOW,
+            ),
+            null,
+        )
+    }
+})
+
+test('does not replay a rejected request and converges failures', async () => {
+    const { assigned, controller, requests } = runtime({
+        fetchResponse: response(401, { marker: '1' }),
+    })
+    controller.setStateProvider(() => ({
+        chatId: -1001451286149,
+        topicId: null,
+    }))
+
+    await Promise.all([
+        controller.wrappedFetch('/api/admin/viewers/1', {
+            method: 'DELETE',
+            body: 'do-not-replay',
+        }),
+        controller.wrappedFetch('/api/chats/-1001451286149/stats'),
+    ])
+
+    assert.equal(requests.length, 2)
+    assert.equal(assigned.length, 1)
+    assert.equal(assigned[0], reauthUrl(ORIGIN))
+    assert.equal(assigned[0].includes('do-not-replay'), false)
+    assert.equal(assigned[0].includes('/api/admin'), false)
+})
+
+test('preserves native application 401 behavior', async () => {
+    const { assigned, controller } = runtime({
+        fetchResponse: response(401),
+    })
+    const result = await controller.wrappedFetch('/api/auth/check')
+
+    assert.equal(result.status, 401)
+    assert.deepEqual(assigned, [])
+})
+
+test('restores pending navigation once', async () => {
+    const storage = new MemoryStorage()
+    const first = runtime({
+        fetchResponse: response(401, { marker: '1' }),
+        storage,
+    })
+    first.controller.setStateProvider(() => ({ chatId: -1001, topicId: 7 }))
+    await first.controller.wrappedFetch('/api/chats/-1001/messages')
+
+    const second = runtime({ storage })
+    assert.deepEqual(second.controller.takePendingNavigation(), {
+        version: 1,
+        createdAt: NOW,
+        origin: ORIGIN,
+        method: 'GET',
+        path: '/',
+        chatId: -1001,
+        topicId: 7,
+    })
+    assert.equal(second.controller.takePendingNavigation(), null)
+})
+
+test('prevents a repeated navigation loop', async () => {
+    const storage = new MemoryStorage()
+    const first = runtime({
+        fetchResponse: response(401, { marker: '1' }),
+        storage,
+    })
+    await first.controller.wrappedFetch('/api/chats')
+    assert.equal(first.assigned.length, 1)
+
+    const second = runtime({
+        fetchResponse: response(401, { marker: '1' }),
+        storage,
+    })
+    await second.controller.wrappedFetch('/api/chats')
+    assert.deepEqual(second.assigned, [])
+})
+
+test('probes the same-origin session before reconnecting WebSocket', async () => {
+    const { assigned, controller, requests } = runtime({
+        fetchResponse: response(401, {
+            marker: '1',
+            url: `${ORIGIN}/oauth2/session`,
+        }),
+    })
+
+    assert.equal(await controller.reauthenticateIfSessionExpired(), true)
+    assert.equal(requests.length, 1)
+    assert.equal(requests[0][0], '/oauth2/session')
+    assert.equal(requests[0][1].cache, 'no-store')
+    assert.equal(assigned.length, 1)
+})
+
+test('loads the interceptor before application bootstrap and parses scripts', () => {
+    const html = readFileSync('src/web/templates/index.html', 'utf8')
+    assert.ok(
+        html.indexOf('/static/sso-reauth.js') < html.indexOf('cdn.tailwindcss.com'),
+    )
+    assert.match(html, /setStateProvider\(\(\) =>/)
+    assert.match(html, /takePendingNavigation\(\)/)
+    assert.match(html, /reauthenticateIfSessionExpired\(\)/)
+
+    for (const match of html.matchAll(/<script(?:\s[^>]*)?>([\s\S]*?)<\/script>/g)) {
+        if (match[1].trim()) new vm.Script(match[1])
+    }
+})
