new file mode 100644
index 0000000..cf97181
--- /dev/null
+++ b/src/web/static/sso-reauth.js
@@ -0,0 +1,248 @@
+(function (root, factory) {
+    const api = factory()
+
+    if (typeof module === 'object' && module.exports) {
+        module.exports = api
+    }
+
+    if (root && root.window === root && typeof root.fetch === 'function') {
+        root.telegramArchiveSso = api.installSsoReauthentication({
+            windowObject: root,
+        })
+    }
+})(typeof globalThis === 'undefined' ? this : globalThis, function () {
+    'use strict'
+
+    const PENDING_VERSION = 1
+    const PENDING_KEY = 'telegram-archive.sso.pending-navigation.v1'
+    const ATTEMPT_KEY = 'telegram-archive.sso.reauth-attempt.v1'
+    const MAX_PENDING_AGE_MS = 5 * 60 * 1000
+    const MAX_PENDING_BYTES = 4 * 1024
+    const REAUTH_RETRY_DELAY_MS = 60 * 1000
+    const REAUTH_HEADER = 'x-sso-reauth'
+    const SESSION_PATH = '/oauth2/session'
+
+    const validIdentifier = (value) =>
+        Number.isSafeInteger(value) && value !== 0
+
+    const pendingNavigationFor = (
+        state,
+        origin,
+        createdAt = Date.now(),
+    ) => {
+        const chatId = validIdentifier(state?.chatId) ? state.chatId : null
+        const topicId = chatId !== null && validIdentifier(state?.topicId)
+            ? state.topicId
+            : null
+
+        return {
+            version: PENDING_VERSION,
+            createdAt,
+            origin,
+            method: 'GET',
+            path: '/',
+            chatId,
+            topicId,
+        }
+    }
+
+    const parsePendingNavigation = (
+        raw,
+        origin,
+        now = Date.now(),
+    ) => {
+        if (typeof raw !== 'string' || raw.length > MAX_PENDING_BYTES) {
+            return null
+        }
+
+        try {
+            const pending = JSON.parse(raw)
+            if (
+                pending.version !== PENDING_VERSION ||
+                !Number.isFinite(pending.createdAt) ||
+                pending.createdAt > now + REAUTH_RETRY_DELAY_MS ||
+                now - pending.createdAt > MAX_PENDING_AGE_MS ||
+                pending.origin !== origin ||
+                pending.method !== 'GET' ||
+                pending.path !== '/' ||
+                !(pending.chatId === null || validIdentifier(pending.chatId)) ||
+                !(pending.topicId === null || validIdentifier(pending.topicId)) ||
+                (pending.chatId === null && pending.topicId !== null)
+            ) {
+                return null
+            }
+
+            return {
+                version: PENDING_VERSION,
+                createdAt: pending.createdAt,
+                origin,
+                method: 'GET',
+                path: '/',
+                chatId: pending.chatId,
+                topicId: pending.topicId,
+            }
+        } catch {
+            return null
+        }
+    }
+
+    const sameOriginResponse = (response, origin) => {
+        if (!response?.url) return false
+        try {
+            return new URL(response.url, origin).origin === origin
+        } catch {
+            return false
+        }
+    }
+
+    const isSsoReauthResponse = (response, origin) =>
+        response?.status === 401 &&
+        response.headers?.get(REAUTH_HEADER) === '1' &&
+        sameOriginResponse(response, origin)
+
+    const reauthUrl = (origin) => {
+        const returnUrl = new URL('/', origin).href
+        return `/oauth2/start?rd=${encodeURIComponent(returnUrl)}`
+    }
+
+    const createSsoReauthController = ({
+        fetchImpl,
+        location,
+        storage,
+        now = () => Date.now(),
+    }) => {
+        let navigating = false
+        let stateProvider = () => null
+
+        const getStored = (key) => {
+            try {
+                return storage.getItem(key)
+            } catch {
+                return null
+            }
+        }
+
+        const removeStored = (key) => {
+            try {
+                storage.removeItem(key)
+            } catch {
+                // Reauthentication remains safe if storage is unavailable.
+            }
+        }
+
+        const pendingRaw = getStored(PENDING_KEY)
+        removeStored(PENDING_KEY)
+        let pendingToRestore = pendingRaw === null
+            ? null
+            : parsePendingNavigation(pendingRaw, location.origin, now())
+
+        const beginReauthentication = () => {
+            if (navigating) return true
+
+            const attemptedAt = Number(getStored(ATTEMPT_KEY))
+            const age = now() - attemptedAt
+            if (
+                Number.isFinite(attemptedAt) &&
+                attemptedAt > 0 &&
+                age >= 0 &&
+                age < REAUTH_RETRY_DELAY_MS
+            ) {
+                return true
+            }
+
+            let state = null
+            try {
+                state = stateProvider()
+            } catch {
+                // Restoring the current chat is optional; login is not.
+            }
+
+            try {
+                storage.setItem(
+                    PENDING_KEY,
+                    JSON.stringify(
+                        pendingNavigationFor(state, location.origin, now()),
+                    ),
+                )
+                storage.setItem(ATTEMPT_KEY, String(now()))
+            } catch {
+                // Only restoration and the persisted loop guard are lost.
+            }
+
+            navigating = true
+            location.assign(reauthUrl(location.origin))
+            return true
+        }
+
+        const inspectResponse = (response) => {
+            if (isSsoReauthResponse(response, location.origin)) {
+                return beginReauthentication()
+            }
+            if (
+                !navigating &&
+                response?.ok &&
+                sameOriginResponse(response, location.origin)
+            ) {
+                removeStored(ATTEMPT_KEY)
+            }
+            return false
+        }
+
+        const wrappedFetch = async (input, init) => {
+            const response = await fetchImpl(input, init)
+            inspectResponse(response)
+            return response
+        }
+
+        const reauthenticateIfSessionExpired = async () => {
+            try {
+                const response = await fetchImpl(SESSION_PATH, {
+                    cache: 'no-store',
+                    credentials: 'same-origin',
+                    headers: { Accept: 'application/json' },
+                })
+                return inspectResponse(response)
+            } catch {
+                return false
+            }
+        }
+
+        const setStateProvider = (provider) => {
+            stateProvider = typeof provider === 'function'
+                ? provider
+                : () => null
+        }
+
+        const takePendingNavigation = () => {
+            const pending = pendingToRestore
+            pendingToRestore = null
+            return pending
+        }
+
+        return {
+            reauthenticateIfSessionExpired,
+            setStateProvider,
+            takePendingNavigation,
+            wrappedFetch,
+        }
+    }
+
+    const installSsoReauthentication = ({ windowObject }) => {
+        const controller = createSsoReauthController({
+            fetchImpl: windowObject.fetch.bind(windowObject),
+            location: windowObject.location,
+            storage: windowObject.sessionStorage,
+        })
+        windowObject.fetch = controller.wrappedFetch
+        return controller
+    }
+
+    return {
+        createSsoReauthController,
+        installSsoReauthentication,
+        isSsoReauthResponse,
+        parsePendingNavigation,
+        pendingNavigationFor,
+        reauthUrl,
+    }
+})
