diff --git a/backend/config/managedSlskd.js b/backend/config/managedSlskd.js
new file mode 100644
index 0000000..7e42ac1
--- /dev/null
+++ b/backend/config/managedSlskd.js
@@ -0,0 +1,62 @@
+function parseBoolean(value) {
+  return String(value || "").trim().toLowerCase() === "true";
+}
+
+function parsePriority(value) {
+  const parsed = Number.parseInt(value, 10);
+  if (!Number.isFinite(parsed) || parsed < 1 || parsed > 1000) {
+    throw new Error("AURRAL_SLSKD_PRIORITY must be between 1 and 1000");
+  }
+  return parsed;
+}
+
+export function getManagedSlskdSettings(env = process.env) {
+  if (!parseBoolean(env.AURRAL_SLSKD_MANAGED)) return null;
+
+  const url = String(env.AURRAL_SLSKD_URL || "").trim();
+  const apiKey = String(env.AURRAL_SLSKD_API_KEY || "").trim();
+  if (!url) throw new Error("AURRAL_SLSKD_URL is required for managed slskd");
+  if (!apiKey) {
+    throw new Error("AURRAL_SLSKD_API_KEY is required for managed slskd");
+  }
+
+  const preferredFormat = String(
+    env.AURRAL_SLSKD_PREFERRED_FORMAT || "flac",
+  ).trim().toLowerCase();
+  if (!["flac", "mp3"].includes(preferredFormat)) {
+    throw new Error("AURRAL_SLSKD_PREFERRED_FORMAT must be flac or mp3");
+  }
+
+  return {
+    enabled: true,
+    url,
+    apiKey,
+    priority: parsePriority(env.AURRAL_SLSKD_PRIORITY || "10"),
+    preferredFormat,
+    preferredFormatStrict: parseBoolean(env.AURRAL_SLSKD_STRICT_FORMAT),
+    cleanupAfterRuns: parseBoolean(env.AURRAL_SLSKD_CLEANUP_AFTER_RUNS),
+    managed: true,
+  };
+}
+
+export function applyManagedSlskdSettings(integrations, env = process.env) {
+  const managed = getManagedSlskdSettings(env);
+  if (!managed) return integrations;
+  return { ...integrations, slskd: managed };
+}
+
+export function preserveStoredSlskdSettings(
+  integrations,
+  storedIntegrations,
+  env = process.env,
+) {
+  if (!getManagedSlskdSettings(env)) return integrations;
+
+  const preserved = { ...integrations };
+  if (storedIntegrations.slskd === undefined) {
+    delete preserved.slskd;
+  } else {
+    preserved.slskd = storedIntegrations.slskd;
+  }
+  return preserved;
+}
